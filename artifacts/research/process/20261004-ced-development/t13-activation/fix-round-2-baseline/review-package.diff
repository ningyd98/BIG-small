+
+    def identity_hash(self) -> str:
+        payload = self.model_dump(mode="json")
+        for key in (
+            "status",
+            "reason",
+            "ack_status",
+            "apply_hash",
+            "accepted_plan_version",
+            "accepted_command_seq",
+            "executing_plan_version",
+            "executing_command_seq",
+            "activation_token",
+            "stage_attempt_id",
+            "stage_ack",
+            "resume_ack",
+            "start_receipt",
+        ):
+            payload.pop(key)
+        return replan_payload_hash(payload)
+
+    def validate_ack(
+        self,
+        ack: CommandAck,
+        *,
+        token: str | None = None,
+        require_acceptance: bool = True,
+    ) -> None:
+        if (
+            type(ack.accepted) is not bool
+            or (require_acceptance and (not ack.accepted or ack.status != "ACCEPTED"))
+            or ack.task_id != self.task_id
+            or ack.plan_version != self.new_plan_version
+            or ack.command_seq != self.new_command_seq
+            or ack.details.get("repair_id") != self.repair_id
+            or ack.details.get("payload_hash") != self.payload_hash
+            or not isinstance(ack.details.get("activation_token"), str)
+            or not ack.details["activation_token"].strip()
