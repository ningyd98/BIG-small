+            if any((self.activation_token, self.stage_ack, self.resume_ack, self.start_receipt)):
+                raise ValueError("diagnostic record cannot assert edge effects")
+            return self
+        candidate = self.candidate_contract
+        if (
+            not self.repair_id
+            or not self.checkpoint_hash
+            or not self.request_payload_hash
+            or not self.response_payload_hash
+            or candidate.task_id != self.task_id
+            or self.payload_hash != replan_payload_hash(candidate)
+            or self.new_plan_version != candidate.plan_version
+            or self.new_command_seq != candidate.command_seq
+            or self.candidate_plan_version != candidate.plan_version
+            or self.candidate_command_seq != candidate.command_seq
+            or self.new_plan_version != self.previous_plan_version + 1
+            or self.new_command_seq <= self.previous_command_seq
+        ):
+            raise ValueError("candidate binding mismatch")
+        accepted = self.accepted_plan_version is not None or self.accepted_command_seq is not None
+        if accepted:
+            if self.stage_ack is None:
+                raise ValueError("accepted candidate requires actual stage acknowledgement")
+            self.validate_ack(self.stage_ack, token=self.activation_token)
+            if (
+                self.accepted_plan_version != candidate.plan_version
+                or self.accepted_command_seq != candidate.command_seq
+            ):
+                raise ValueError("accepted version mismatch")
+        elif any(
+            (
+                self.activation_token,
+                self.accepted_plan_version is not None,
+                self.accepted_command_seq is not None,
+                self.resume_ack,
+                self.start_receipt,
+            )
+        ):
+            raise ValueError("unaccepted candidate cannot assert edge state")
+        if self.stage_ack is not None and not accepted and self.status != "REJECTED":
+            raise ValueError("unbound/unaccepted stage response is rejection evidence only")
+        if self.stage_ack is not None and not self.stage_attempt_id:
+            raise ValueError("stage response requires actual claimed attempt")
+        if self.status in {"EDGE_ACCEPTED", "ACTIVATED", "EXECUTION_STARTED"} and not accepted:
+            raise ValueError("stage acknowledgement required")
+        if self.status == "PREPARED" and accepted:
+            raise ValueError("PREPARED cannot assert stage acceptance")
+        if self.resume_ack is not None:
+            self.validate_ack(
+                self.resume_ack, token=self.activation_token, require_acceptance=False
+            )
+            if self.status not in {"ACTIVATED", "EXECUTION_STARTED"}:
+                raise ValueError("resume requires activation")
+        if self.start_receipt is not None:
+            receipt = self.start_receipt
+            if (
+                receipt.repair_id != self.repair_id
+                or receipt.task_id != self.task_id
+                or receipt.plan_version != candidate.plan_version
+                or receipt.command_seq != candidate.command_seq
+                or receipt.activation_token != self.activation_token
+                or receipt.payload_hash != self.payload_hash
+                or self.executing_plan_version != candidate.plan_version
+                or self.executing_command_seq != candidate.command_seq
+                or self.status != "EXECUTION_STARTED"
+            ):
+                raise ValueError("execution receipt binding mismatch")
+        elif (
+            self.status == "EXECUTION_STARTED"
+            or self.executing_plan_version is not None
+            or self.executing_command_seq is not None
+        ):
+            raise ValueError("execution start requires actual receipt")
+        return self
+
+    def validate_transition(self, previous: ReplanApplyRecord, *, activation: bool = False) -> None:
+        if self.identity_hash() != previous.identity_hash():
+            raise ValueError("immutable candidate identity changed")
+        for key in (
+            "stage_attempt_id",
+            "stage_ack",
+            "activation_token",
+            "resume_ack",
+            "start_receipt",
+        ):
+            old = getattr(previous, key)
+            if old and getattr(self, key) != old:
+                raise ValueError("persisted edge evidence changed")
+        allowed = {
+            "PREPARED": {"PREPARED", "EDGE_ACCEPTED", "REJECTED", "EXPIRED"},
+            "EDGE_ACCEPTED": {"ACTIVATED", "REJECTED", "EXPIRED"}
+            if activation
+            else {"REJECTED", "EXPIRED"},
+            "ACTIVATED": {"ACTIVATED", "EXECUTION_STARTED"},
+        }
+        if self.status not in allowed.get(previous.status, set()):
+            raise ValueError("nonmonotonic replan transition")
+        if previous.status == "PREPARED" and self.status == "PREPARED":
+            if previous.stage_attempt_id or not self.stage_attempt_id:
+                raise ValueError("PREPARED update requires first durable stage claim")
+        if self.status == "EDGE_ACCEPTED" and not previous.stage_attempt_id:
+            raise ValueError("actual staging requires a durable stage attempt claim")
+        if previous.status == "ACTIVATED" and self.status == "ACTIVATED":
+            if previous.resume_ack is not None or self.resume_ack is None:
+                raise ValueError("ACTIVATED update requires first actual resume acknowledgement")
 
 
