import hashlib,json,tempfile
from pathlib import Path
from datetime import UTC,datetime
from cloud_edge_robot_arm.research import native_clock_source_v2 as api
root=Path.cwd()
metadata=json.loads((root/'artifacts/research/process/20261004-ced-development/t7b-native-calibration-source/reset-utc-v2-design/fix-round-1/go/build-metadata.json').read_text())
fixture=json.loads((root/'tools/research/native-clock-v2/testdata/software-only-exchange.json').read_text())
before=api.ClockExchangeOriginalV2.from_payload(fixture['causal_exchanges']['A'])
after=api.ClockExchangeOriginalV2.from_payload(fixture['causal_exchanges']['B'])
pairs=(api.ClockTupleV2('SOFTWARE_ONLY-clock-1',1,100,datetime(2026,10,5,tzinfo=UTC),110),api.ClockTupleV2('SOFTWARE_ONLY-clock-1',2,120,datetime(2026,10,5,tzinfo=UTC),130))
with tempfile.TemporaryDirectory(prefix='bigsmall-r02-pin-red-') as scratch:
 binary=Path(scratch)/'wire'
 original=root/metadata['binary_path']
 binary.write_bytes(original.read_bytes())
 binary.chmod(original.stat().st_mode)
 verifier=api.GoWireVerifierV2(binary,binary_sha256=metadata['binary_sha256'],source_root=root,source_hashes=metadata['source_hashes'])
 positive=api.verify_causal_slab(pairs,before,after,verifier,acquisition_sha256='a'*64)
 assert not positive.reasons and len(positive.conditional_pair_utc_intervals)==2
 print('POSITIVE_CONTROL',json.dumps({'intervals':len(positive.conditional_pair_utc_intervals),'reasons':positive.reasons,'binary_sha256':hashlib.sha256(binary.read_bytes()).hexdigest()},sort_keys=True))
 original_run=api.subprocess.run
 calls=0
 def interleaved_run(*args,**kwargs):
  global calls
  calls+=1
  if calls==2:
   with binary.open('ab') as f:
    f.write(b'SOFTWARE_ONLY appended drift between pin check and final B exec')
  return original_run(*args,**kwargs)
 api.subprocess.run=interleaved_run
 try:
  result=api.verify_causal_slab(pairs,before,after,verifier,acquisition_sha256='a'*64)
 finally:
  api.subprocess.run=original_run
 actual=hashlib.sha256(binary.read_bytes()).hexdigest()
 assert actual!=metadata['binary_sha256']
 print('QUALIFIED_RED_OBSERVED',json.dumps({'actual_subprocess_calls':calls,'binary_sha256_before':metadata['binary_sha256'],'binary_sha256_after':actual,'intervals':len(result.conditional_pair_utc_intervals),'reasons':result.reasons,'native_authority':result.native_authority,'utc_calibration':result.utc_calibration,'subprocess_outputs_fabricated':False},sort_keys=True))
 try:
  verifier._revalidate()
 except ValueError as error:
  print('SAME_EXISTING_PIN_GUARD_REJECTS_AFTER_RETURN',str(error))
 else:
  raise AssertionError('counterexample does not violate existing pin contract')
 assert result.reasons and not result.conditional_pair_utc_intervals,'changed pinned binary executed for final B but causal slab returned successful intervals'

NEW_QUALIFIED_RED_SCRIPT_END
