+    def event(self):
+        return {
+            "event": "TARGET_MOTION_STARTED",
+            "physics_step": self.total_physics_steps,
+            "sim_time_s": self.sim_time_s,
+            "speed_m_s": 0.02,
+            "direction_y": 1.0,
+            "duration_s": 1.0,
+            "mechanism": "CPU fixture only; not actual fault evidence",
