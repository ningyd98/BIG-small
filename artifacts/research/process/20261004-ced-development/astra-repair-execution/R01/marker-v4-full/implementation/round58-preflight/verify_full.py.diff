+def adapt_old_v3_end(row, *, protocol):
+    P.require(
+        protocol == "research.custom-whole-step-guarded-rgbd.v3" and row["event"] == "END",
+        "fixed old V3 END protocol required",
+    )
+    for field in ("observation_checksum_sha256", "observation_json_sha256"):
+        value = row.get(field)
+        P.require(
+            type(value) is str and len(value) == 64 and all(c in "0123456789abcdef" for c in value),
+            "old V3 END valid long SHA field required: " + field,
+        )
+    aliases = {
+        "checksum": row["observation_checksum_sha256"],
+        "original_sha256": row["observation_json_sha256"],
+    }
+    for alias, value in aliases.items():
+        P.require(alias not in row or row[alias] == value, "old V3 END conflicting alias: " + alias)
+    return {**row, **aliases}
+
+
+def validate_old_v3_marker_binding(marker, saved, member):
+    step = marker["physics_step"]
+    relative = "whole-step/" + saved["file"]
+    P.require(
+        relative == f"whole-step/frames/{step:07d}.json.gz"
+        and member["path"] == relative
+        and saved["compressed_sha256"] == member["sha256"]
+        and saved["compressed_bytes"] == member["bytes"]
+        and marker["observation_id"] == saved["observation_id"]
+        and marker["checksum"] == saved["checksum"]
+        and identity(marker) == identity(saved),
+        "old marker source/manifest/index binding",
+    )
+
