+def recipe_cpu_inventory():
+    actions = {
+        (i, phase): dict(event=phase, action_ordinal=i)
+        for i in range(1, 10)
+        for phase in ("ACTION_BEGIN", "ACTION_END")
+    }
+    teacher_actions = {i: dict(event="TEACHER_ACTION", action_ordinal=i) for i in range(1, 10)}
+    return actions, teacher_actions
+
+
+@pytest.mark.parametrize(
+    "variant",
+    [
+        "healthy",
+        "teacher_extra10",
+        "teacher_zero",
+        "teacher_bool",
+        "teacher_missing",
+        "teacher_value_bool",
+        "teacher_value_mismatch",
+        "action_missing",
+        "action_extra",
+        "action_key_bool",
+        "action_value_bool",
+        "action_value_mismatch",
+    ],
+)
+def test_full_trace_exact_recipe_event_inventory(variant):
+    actions, teacher_actions = recipe_cpu_inventory()
+    if variant == "teacher_extra10":
+        teacher_actions[10] = dict(event="TEACHER_ACTION", action_ordinal=10)
+    elif variant == "teacher_zero":
+        teacher_actions[0] = dict(event="TEACHER_ACTION", action_ordinal=0)
+    elif variant == "teacher_bool":
+        del teacher_actions[1]
+        teacher_actions[True] = dict(event="TEACHER_ACTION", action_ordinal=True)
+    elif variant == "teacher_missing":
+        del teacher_actions[9]
+    elif variant == "teacher_value_bool":
+        teacher_actions[1]["action_ordinal"] = True
+    elif variant == "teacher_value_mismatch":
+        teacher_actions[1]["action_ordinal"] = 2
+    elif variant == "action_missing":
+        del actions[(1, "ACTION_END")]
+    elif variant == "action_extra":
+        actions[(10, "ACTION_END")] = dict(event="ACTION_END", action_ordinal=10)
+    elif variant == "action_key_bool":
+        del actions[(1, "ACTION_END")]
+        actions[(True, "ACTION_END")] = dict(event="ACTION_END", action_ordinal=True)
+    elif variant == "action_value_bool":
+        actions[(1, "ACTION_END")]["action_ordinal"] = True
+    elif variant == "action_value_mismatch":
+        actions[(1, "ACTION_END")]["action_ordinal"] = 2
+    if variant == "healthy":
+        V.validate_recipe_event_inventory(actions, teacher_actions)
+    else:
+        with pytest.raises(ValueError):
+            V.validate_recipe_event_inventory(actions, teacher_actions)
