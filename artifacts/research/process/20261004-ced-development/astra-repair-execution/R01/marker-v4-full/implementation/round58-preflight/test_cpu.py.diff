+def coordinator_cpu_end(tmp_path):
+    base = R.load_runner()
+    capture = Capture()
+    original_capture = capture.__call__
+
+    class CoordinatedCapture(Capture):
+        def __call__(self):
+            self.last_capture = {"after_guard": {"cpu": 1}, "after_state": {"cpu": 1}}
+            return original_capture()
+
+    capture = CoordinatedCapture()
+    recorder = R.FullRGBDRecorder(
+        tmp_path / "whole-step",
+        capture,
+        episode_id="cpu",
+        max_sample_gap_s=0.005,
+        expected_physics_steps=0,
+        final_guard=capture.final,
+    )
+    publications = []
+
+    class Journal:
+        last_control = last_physics = None
+
+        def ensure(self, _):
+            return None
+
+        def emit(self, event, **payload):
+            row = {"event": event, **payload}
+            publications.append(row)
+            return row
+
+    backend = SimpleNamespace(command_records=[])
+    coordinator = base.AcquisitionCoordinator(
+        backend, Journal(), recorder, SimpleNamespace(current=None), capture
+    )
+    snapshot = SimpleNamespace(episode_id="cpu", physics_step=0, sim_time_s=0.0)
+    recorder.observe_step(episode_id="cpu", physics_step=0, sim_time_s=0.0)
+    returned = coordinator.record(snapshot)
+    index_end = next(
+        row
+        for row in map(json.loads, (recorder.directory / "index.jsonl").read_text().splitlines())
+        if row["event"] == "END"
+    )
+    acquisition_end = next(row for row in publications if row["event"] == "ACQUISITION_END")
+    recorder.finish(final_step=0, final_sim_time_s=0.0)
+    return returned, index_end, acquisition_end
+
+
+def test_full_recorder_coordinator_end_record_identity(tmp_path):
+    returned, index_end, acquisition_end = coordinator_cpu_end(tmp_path)
+    assert returned == index_end == acquisition_end["saved"]
+    assert returned["event"] == "END" and returned["schema"] == "research.full-marker-v4-index.v1"
+    V.validate_acquisition_saved(acquisition_end, index_end)
+
