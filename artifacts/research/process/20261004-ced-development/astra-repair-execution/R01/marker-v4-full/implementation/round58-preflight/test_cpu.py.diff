+def test_full_trace_exact_recipe_event_inventory_called_by_real_terminal_path(
+    tmp_path, monkeypatch
+):
+    attempt, header, contract = tiny_trace_metadata(tmp_path, [1])
+    called = []
+    real = V.validate_recipe_event_inventory
+
+    def checked(actions, teacher_actions):
+        called.append((copy.deepcopy(actions), copy.deepcopy(teacher_actions)))
+        return real(actions, teacher_actions)
+
+    monkeypatch.setattr(V, "validate_recipe_event_inventory", checked)
+    trace = V.validate_full_trace(attempt, header, contract)
+    assert len(called) == 1 and set(called[0][1]) == {1}
+    assert not trace["trace_valid"]
