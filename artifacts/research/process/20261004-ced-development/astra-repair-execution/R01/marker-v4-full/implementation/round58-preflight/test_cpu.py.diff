+@pytest.mark.parametrize(
+    "variant",
+    [
+        "healthy",
+        "missing_checksum",
+        "missing_json",
+        "sparse_only",
+        "protocol",
+        "event",
+        "invalid_sha",
+        "conflict_checksum",
+        "conflict_json",
+    ],
+)
+def test_old_v3_end_schema_adapter(variant):
+    saved, _, _ = old_v3_end_fixture()
+    protocol = "research.custom-whole-step-guarded-rgbd.v3"
+    if variant == "missing_checksum":
+        del saved["observation_checksum_sha256"]
+    elif variant == "missing_json":
+        del saved["observation_json_sha256"]
+    elif variant == "sparse_only":
+        saved["checksum"] = saved.pop("observation_checksum_sha256")
+        saved["original_sha256"] = saved.pop("observation_json_sha256")
+    elif variant == "protocol":
+        protocol = "research.custom-sparse-guarded-marker-v4.v1"
+    elif variant == "event":
+        saved["event"] = "BEGIN"
+    elif variant == "invalid_sha":
+        saved["observation_json_sha256"] = "invalid"
+    elif variant == "conflict_checksum":
+        saved["checksum"] = "f" * 64
+    elif variant == "conflict_json":
+        saved["original_sha256"] = "f" * 64
+    before = copy.deepcopy(saved)
+    if variant == "healthy":
+        adapted = V.adapt_old_v3_end(saved, protocol=protocol)
+        assert adapted["checksum"] == saved["observation_checksum_sha256"]
+        assert adapted["original_sha256"] == saved["observation_json_sha256"]
+        assert all(adapted[key] == value for key, value in saved.items())
+        assert adapted is not saved
+    else:
+        with pytest.raises(ValueError):
+            V.adapt_old_v3_end(saved, protocol=protocol)
+    assert saved == before
+
