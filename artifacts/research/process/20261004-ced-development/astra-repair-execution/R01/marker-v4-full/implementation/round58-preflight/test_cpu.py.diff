+def tiny_trace_metadata(tmp_path, ordinals):
+    attempt = tmp_path / "attempt"
+    attempt.mkdir()
+    (attempt / "whole-step").mkdir()
+    (attempt / "whole-step/index.jsonl").write_text("")
+    P.write_new(attempt / "whole-step/summary.json", {})
+    P.write_new(
+        attempt / "summary.json",
+        dict(run_status="COMPLETED_SINGLE_ATTEMPT", action_begins=9, action_ends=9),
+    )
+    P.write_new(
+        attempt / "terminal.json",
+        dict(
+            episode_id="cpu",
+            final_step=0,
+            final_sim_time_s=0.0,
+            operation_ledger=[],
+            operation_observer_failures=[],
+            commands=[],
+        ),
+    )
+    P.write_new(attempt / "teacher-evidence.json", dict(physical_samples=[], actions=[]))
+    rows = [
+        dict(
+            record_seq=i,
+            event="TEACHER_ACTION",
+            action_ordinal=ordinal,
+            source={},
+            clock=dict(monotonic_before_ns=i, monotonic_after_ns=i),
+        )
+        for i, ordinal in enumerate(ordinals, 1)
+    ]
+    (attempt / "nominal-journal.jsonl.gz").write_bytes(
+        gzip.compress(b"".join(json.dumps(row).encode() + b"\n" for row in rows))
+    )
+    _, contract = guarded_cpu_camera()
+    return attempt, {"expected_callback_steps": [0]}, contract
+
+
+@pytest.mark.parametrize("ordinals", [[10], [0], [True], [1, 1]])
+def test_full_trace_exact_recipe_event_inventory_streaming_rejects_extra_or_duplicate(
+    tmp_path, ordinals
+):
+    attempt, header, contract = tiny_trace_metadata(tmp_path, ordinals)
+    trace = V.validate_full_trace(attempt, header, contract)
+    assert any(
+        error.get("event") == "TEACHER_ACTION" and "teacher" in error["reason"]
+        for error in trace["errors"]
+    )
+
