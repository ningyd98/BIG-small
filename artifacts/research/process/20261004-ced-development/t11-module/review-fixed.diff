+        {"payload_hash": "f" * 64},
+    ],
+)
+def test_prepared_transition_all_request_fields_are_immutable(tmp_path: Path, sqlite, change):
+    repo = (
+        SQLiteAutoModeRepository(tmp_path / "mode.db") if sqlite else InMemoryAutoModeRepository()
+    )
+    initialize(repo)
+    service = ModeTransitionService(repository=repo, clock=lambda: NOW)
+    original = service.prepare(request())
+    with pytest.raises((ValueError, IdempotencyConflictError)):
+        repo.save_transition(original.model_copy(update=change))
+    assert repo.get_transition(original.transition_id) == original
+    assert service.prepare(request()) == original
+    assert repo.get_status("task").mode_version == 1
+    assert service.commit(original.transition_id).to_mode == ETEA
+    assert repo.get_status("task").current_mode == ETEA
+    repo.close()
+
