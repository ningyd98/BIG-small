+def _input_value(value: Any) -> Any:
+    """Canonicalize frozen inputs without deepcopying read-only mapping proxies."""
+    if isinstance(value, BaseModel):
+        return value.model_dump(mode="json")
+    if isinstance(value, datetime):
+        return value.isoformat()
+    if isinstance(value, Enum):
+        return value.value
+    if isinstance(value, Mapping):
+        return {str(key): _input_value(item) for key, item in value.items()}
+    if is_dataclass(value) and not isinstance(value, type):
+        return {field.name: _input_value(getattr(value, field.name)) for field in fields(value)}
+    if isinstance(value, (tuple, list)):
+        return [_input_value(item) for item in value]
+    if isinstance(value, (set, frozenset)):
+        return sorted(_input_value(item) for item in value)
+    return value
+
+
