+@pytest.mark.parametrize(
+    "change",
+    [
+        {"transition_id": "changed-id"},
+        {"to_mode": ControlMode.AUTO},
+        {"from_mode": ETEA},
+        {"task_id": "foreign"},
+        {"expected_mode_version": 2},
+        {"new_mode_version": 3},
+        {"idempotency_key": "new-key"},
+        {"decision_id": "different"},
+        {"reason": "changed"},
