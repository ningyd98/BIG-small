+  const names = [...new Set([...hypotheses, ...Object.keys(effects)])];
+  const adjusted = record(family.holm_adjusted_p);
+  const rows = names.map((name) => ({ name, values: record(effects[name]) }));
+  const timeline = view.timeline;
+
+  return (
