--- released/tests/test_research_results_api.py
+++ fixed/tests/test_research_results_api.py
@@ -183,3 +183,38 @@
     (root / "run-1/analysis" / artifact).write_text("null\n")
     response = browser(monkeypatch, root).get("/api/v1/research/runs/run-1/evidence")
     assert response.status_code == 409
+
+
+@pytest.mark.parametrize(
+    "artifact,value",
+    [
+        ("assignments.json", None),
+        ("assignments.json", []),
+        ("assignments.json", {"assignments": [None]}),
+        ("pools.json", None),
+        ("pools.json", []),
+        ("pools.json", {"formal": None}),
+        ("pools.json", {"formal": [None]}),
+        ("records.jsonl", None),
+        ("records.jsonl", []),
+        ("records.jsonl", {"assignment": None}),
+    ],
+)
+def test_rehashed_malformed_raw_tables_return_conflict(
+    prepared_sources, monkeypatch, tmp_path, artifact, value
+):
+    import hashlib
+
+    original, _ = prepared_sources
+    root = tmp_path / "artifacts"
+    shutil.copytree(original, root)
+    source = root / "run-1/runs" / artifact
+    source.write_text(json.dumps(value) + "\n")
+    report = root / "run-1/analysis/report.json"
+    payload = json.loads(report.read_text())
+    name = {"assignments.json": "assignments", "pools.json": "pools", "records.jsonl": "records"}
+    payload["source_hashes"][name[artifact]] = hashlib.sha256(source.read_bytes()).hexdigest()
+    report.write_text(json.dumps(payload))
+    response = browser(monkeypatch, root).get("/api/v1/research/runs/run-1/evidence")
+    assert response.status_code == 409
+    assert response.json()["error"] == "research_artifact_invalid"
