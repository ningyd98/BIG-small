+                    return action
+            action = self._save(
+                context,
+                candidates,
+                estimates,
+                costs,
+                empty,
+                DecisionAction.STOP,
+                "DUPLICATE_CHANGED",
+                ("duplicate_event_inputs_changed_or_expired",),
+                now,
+            )
