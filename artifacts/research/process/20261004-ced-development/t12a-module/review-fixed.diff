+                    context,
+                    build_candidates(current, action_contracts=contracts),
+                    (),
+                    costs,
+                    empty,
+                    DecisionAction.STOP,
+                    "HARD_STOP",
+                    tuple(reason for reason in (
+                        contract_error, "hard_stop_or_budget_exhausted_after_contract_return"
+                    ) if reason is not None),
+                    now,
+                )
