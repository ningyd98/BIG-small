+                    and (
+                        not _number(e.motion_bound_m_s)
+                        or e.motion_bound_m_s < estimate.motion_bound_m_s
+                    )
+                ):
+                    reasons.append("contract_understates_calibrated_bounds")
+        result.append(
+            ActionCandidate(
+                f"{action.value.lower()}-{identity[:24]}",
+                action,
+                not reasons,
+                tuple(reasons),
+                contract,
+            )
+        )
