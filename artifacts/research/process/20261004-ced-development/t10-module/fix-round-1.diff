+def test_replay_binds_robot_facts_clock_and_calibration():
+    from cloud_edge_robot_arm.edge.evidence.conditions import ConditionSpec
+
+    online = online_evidence()
+    value = api().Opportunity(
+        "frozen",
+        "episode",
+        online.observation,
+        contract(
+            preconditions=(ConditionSpec("gripper_open", sensor_requirements=("robot_state",)),)
+        ),
+        "VALID",
+        replay_at=NOW,
+        replay_calibration_version="cal-1",
+        online_evidence=online,
+    )
+    initial_hash = value.content_hash
+    records = api().replay_opportunities([value], "B3", NOW, "cal-1")
+    online.robot_state.gripper_open = False
+    online.visual_facts["target_visible"]["value"] = False
+    assert value.content_hash == initial_hash
+    assert api().replay_opportunities([value], "B3", NOW, "cal-1")[0].verdict == records[0].verdict
+    with pytest.raises(ValueError, match="clock|configuration"):
+        api().replay_opportunities([value], "B3", NOW + timedelta(seconds=1), "cal-1")
+    with pytest.raises(ValueError, match="clock|configuration"):
+        api().replay_opportunities([value], "B3", NOW, "new-cal")
+    changed = replace(value, replay_at=NOW + timedelta(seconds=1))
+    with pytest.raises(ValueError, match="changed"):
+        api().summarize_gate_replay([changed], records)
