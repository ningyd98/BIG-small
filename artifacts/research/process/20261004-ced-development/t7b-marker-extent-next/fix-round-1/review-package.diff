+def test_direct_registration_rejects_all_nonconcrete_or_forged_nested_marker_carriers():
+    # Break caught: marker aliases or forged fields alter geometry under the same digest.
+    observation = RGBDObservation.model_validate_json(STATIC.read_text())
+    result, registration = replay(observation)
+    assert result.status == "OBSERVED_CANDIDATE" and registration.sources_valid()
+    marker = registration.pose_marker
+    mutable = SimpleNamespace(**asdict(marker), digest=lambda: marker.digest())
+
+    class MarkerSubclass(PoseMarkerRegistration):
+        pass
+
+    subclass = MarkerSubclass(**asdict(marker))
+    forged = replace(marker)
+    object.__setattr__(forged, "dictionary", "FORGED_DICTIONARY")
+    accepted = []
+    for name, carrier in (("mutable", mutable), ("subclass", subclass), ("forged", forged)):
+        try:
+            replace(registration, pose_marker=carrier)
+        except (ValueError, TypeError):
+            continue
+        accepted.append(name)
+    assert accepted == [], f"unsupported nested marker carriers were accepted: {accepted}"
+    detached = replace(registration, pose_marker=marker)
+    before = detached.digest()
+    object.__setattr__(marker, "marker_size_m", 0.0525)
+    assert detached.pose_marker.marker_size_m == 0.045 and detached.digest() == before
