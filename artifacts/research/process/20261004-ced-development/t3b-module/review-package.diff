+def cloud(**overrides):
+    values = dict(
+        role="CLOUD",
+        provider_id="max-profile",
+        provider_location="REMOTE_SERVICE",
+        model_id="qwen3.8-max",
+        revision=None,
+        weight_digest=None,
+        quantization=None,
+        request_config_hash="a" * 64,
+        source_hashes={"vision/messages.py": "b" * 64},
+    )
+    return roles().RoleProviderSnapshot(**(values | overrides))
+
