+def roles():
+    assert importlib.util.find_spec("cloud_edge_robot_arm.vision.role_models") is not None, (
+        "T3b role bindings are missing"
+    )
+    return importlib.import_module("cloud_edge_robot_arm.vision.role_models")
+
