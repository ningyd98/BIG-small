+def cloud_request_settings(planner: RGBDPlannerAdapter) -> dict[str, object]:
+    """Canonical effective adapter settings, derived again at the wire boundary.
+
+    Mutable transport fields override the immutable model snapshot so an endpoint,
+    model, path, provider, timeout or payment-setting drift changes this binding.
+    Secrets and HTTP headers are never included.
+    """
+    snapshot = planner.model_snapshot
+    if snapshot is None:
+        raise ValueError("cloud role requires a model request snapshot")
+    return snapshot.evidence() | {
+        "provider": planner.provider,
+        "model": planner.model_name,
+        "endpoint_hash": hashlib.sha256(planner.base_url.encode()).hexdigest(),
+        "timeout_s": planner.timeout_s,
+        "chat_path": planner.chat_path,
+        "config_version": getattr(planner, "role_config_version", 1),
+        "response_format": {"type": "json_object"},
+        "allow_paid": planner.allow_paid,
+    }
