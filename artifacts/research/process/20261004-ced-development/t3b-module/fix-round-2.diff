+_JSON_ESCAPE = re.compile(
+    r"\\u[dD][89abAB][0-9a-fA-F]{2}\\u[dD][cdefCDEF][0-9a-fA-F]{2}"
+    r'|\\u[0-9a-fA-F]{4}|\\["\\/bfnrt]'
+)
+
+
+def _text_contains_credential(text: str, secret: str) -> bool:
+    """Inspect equivalent JSON escapes in JSON strings and non-JSON error text.
+
+    At most eight decoding passes are allowed. Remaining valid escapes after that
+    bound are conservatively withheld rather than risking opaque nested encoding.
+    No transformed text becomes a wire artifact or a wire hash input.
+    """
+    for _ in range(8):
+        if secret in text:
+            return True
+        decoded = _JSON_ESCAPE.sub(lambda match: json.loads('"' + match.group(0) + '"'), text)
+        if decoded == text:
+            return False
+        text = decoded
+    return secret in text or _JSON_ESCAPE.search(text) is not None
+
+
+def _contains_credential(value: object, secret: str) -> bool:
+    """Inspect all decoded keys/values without recursive Python stack growth."""
+    if not secret:
+        return False
+    pending = [value]
+    while pending:
+        current = pending.pop()
+        if isinstance(current, str):
+            if _text_contains_credential(current, secret):
+                return True
+        elif isinstance(current, dict):
+            pending.extend(current.keys())
+            pending.extend(current.values())
+        elif isinstance(current, (list, tuple)):
+            pending.extend(current)
+    return False
+
+
+def _safe_attempt_record(record: dict[str, Any], secret: str) -> dict[str, Any]:
+    """Withhold sensitive derived/error details; expose only status/count/hash."""
+    if not _contains_credential(record, secret):
+        return record
+    raw_details = json.dumps(record, sort_keys=True, ensure_ascii=True, allow_nan=False).encode()
+    return {
+        "status": "BLOCKED",
+        "wire_artifact_suppressed": True,
+        "details_suppressed": True,
+        "suppressed_details_sha256": _sha(raw_details),
+        "serialized_sent_bytes": record.get("serialized_sent_bytes", 0)
+        if type(record.get("serialized_sent_bytes")) is int and record["serialized_sent_bytes"] >= 0
+        else None,
+        "serialized_received_bytes": record.get("serialized_received_bytes", 0)
+        if type(record.get("serialized_received_bytes")) is int
+        and record["serialized_received_bytes"] >= 0
+        else None,
+    }
 
 
