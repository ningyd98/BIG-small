+def test_each_audit_observes_current_source_drift(tmp_path: Path) -> None:
+    registration = _registration(tmp_path)
+    auditor = _auditor(registration)
+    first = auditor.audit("registered-initial")
+    source = next(iter(registration.current_source_hashes))
+    (registration.current_role_binding.root / source).write_text("# changed current source\n")
+    second = auditor.audit("registered-initial")
+    assert first.status == "UNKNOWN"
+    assert second.status == "INVALID"
+    assert "current_source_drift" in second.reasons
+    assert first.raw_file_hashes == second.raw_file_hashes
+    assert (
+        second.current_source_hashes[source]
+        == hashlib.sha256(
+            (registration.current_role_binding.root / source).read_bytes()
+        ).hexdigest()
+    )
+
