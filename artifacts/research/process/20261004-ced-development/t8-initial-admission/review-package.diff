+def test_raw_inventory_change_during_protocol_read_rejects(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    registration = _registration(tmp_path)
+    original_load = admission.load_protocol
+
+    def changed_read(directory: Path) -> FrozenProtocol:
+        frozen = original_load(directory)
+        _write(registration.evidence_root / "added-failure.json", {"status": "FAILED"})
