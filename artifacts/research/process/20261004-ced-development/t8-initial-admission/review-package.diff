+"""Software boundary tests; these fixtures are not actual INITIAL acceptance evidence."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import FrozenInstanceError, replace
+from pathlib import Path
+
+import pytest
+
+from cloud_edge_robot_arm.datasets.rgbd.models import canonical_json, content_digest
+from cloud_edge_robot_arm.research import admission
+from cloud_edge_robot_arm.research.admission import (
+    InitialSourceAdmissionAuditor,
+    InitialSourceRegistration,
+)
+from cloud_edge_robot_arm.research.protocol import FrozenProtocol, ProtocolSpec
+from cloud_edge_robot_arm.vision.role_models import (
+    RoleModelBundle,
+    RoleProviderSnapshot,
+    configuration_hash,
+)
+from cloud_edge_robot_arm.vision.runtime_binding import RoleRuntimeBinding
+
+
+def _write(path: Path, value: object) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(canonical_json(value) + "\n")
+
+
+def _registration(tmp_path: Path) -> InitialSourceRegistration:
+    """Minimal source-bound software fixture, deliberately missing original raw runs."""
+    repo = tmp_path / "repo"
+    edge_names = [
+        "src/cloud_edge_robot_arm/edge/recovery/verification_router.py",
+        *[
+            f"src/cloud_edge_robot_arm/edge/evidence/{name}.py"
+            for name in ("models", "validator", "conditions")
+        ],
+    ]
+    device_names = ["src/cloud_edge_robot_arm/vision/action_evidence.py"]
+    cloud_names = ["src/cloud_edge_robot_arm/vision/planner.py"]
+    sources = {}
+    for name in edge_names + device_names + cloud_names:
+        path = repo / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text("# explicitly software-only fixture\n")
+        sources[name] = hashlib.sha256(path.read_bytes()).hexdigest()
+    policy = {"status": "NOT_ACCEPTED", "dispatch": False}
+    cloud = RoleProviderSnapshot(
+        "CLOUD",
+        "fixture-cloud",
+        "LOCAL_HOST",
+        "qwen3.8-max",
+        None,
+        None,
+        None,
+        configuration_hash({"fixture": "SOFTWARE_ONLY"}),
+        {name: sources[name] for name in cloud_names},
+    )
+    edge = RoleProviderSnapshot(
+        "EDGE",
+        "fixture-rules",
+        "LOCAL_HOST",
+        None,
+        None,
+        None,
+        None,
+        configuration_hash(policy),
+        {name: sources[name] for name in edge_names},
+    )
+    device = {name: sources[name] for name in device_names}
+    binding = RoleRuntimeBinding(
+        RoleModelBundle(cloud, edge.provider_id, edge.digest(), configuration_hash(device)),
+        edge,
+        device,
+        policy,
+        root=repo,
+    )
+    evidence = tmp_path / "evidence"
+    evidence.mkdir()
+    _write(evidence / "source-hashes.json", sources)
+    for name in sources:
+        archived = evidence / "source" / name
+        archived.parent.mkdir(parents=True, exist_ok=True)
+        archived.write_bytes((repo / name).read_bytes())
+    spec = ProtocolSpec(
+        schema_version="ced.research.v2",
+        tcap_s=120,
+        pool_hashes={"foundation": "1" * 64},
+        model_snapshot_hash=binding.bundle.digest(),
+        opportunity_hash="2" * 64,
+        recovery_fault_manifest_hash="3" * 64,
+        role_bundle_hash=binding.bundle.digest(),
+        selection_manifest_hash="4" * 64,
+        selected_b0_period_s=1,
+        budget_selection_rule_hash="5" * 64,
+        resource_plan_hash="6" * 64,
+    )
+    frozen = FrozenProtocol(
+        spec=spec,
+        stage="INITIAL",
+        content_hash=content_digest({"spec": spec.model_dump(mode="json"), "stage": "INITIAL"}),
+    )
+    protocol = tmp_path / "protocol" / "protocol.json"
+    _write(protocol, frozen.model_dump(mode="json"))
+    return InitialSourceRegistration(evidence, protocol, binding, sources)
+
+
+def _auditor(registration: InitialSourceRegistration) -> InitialSourceAdmissionAuditor:
+    return InitialSourceAdmissionAuditor({"registered-initial": registration})
+
+
+def test_unknown_registered_id_is_unknown_without_path_lookup(tmp_path: Path) -> None:
+    result = _auditor(_registration(tmp_path)).audit("../../unregistered")
+    assert result.status == "UNKNOWN"
+    assert "evidence_id_not_registered" in result.reasons
+    assert result.verified_scope is None
+    assert result.method_admitted is False
+    assert result.execution_admitted is False
+
+
+def test_unsupported_scope_is_rejected(tmp_path: Path) -> None:
+    with pytest.raises(ValueError, match="scope"):
+        _auditor(_registration(tmp_path)).audit("registered-initial", scope="EXECUTION")  # type: ignore[arg-type]
+
+
+def test_missing_original_summary_never_accepts_protocol_hash(tmp_path: Path) -> None:
+    result = _auditor(_registration(tmp_path)).audit("registered-initial")
+    assert result.status == "UNKNOWN"
+    assert "initial_source_missing" in result.reasons
+    assert result.protocol_hash is not None
+    assert result.inventory_hash is not None
+    assert "evidence:source-hashes.json" in result.raw_file_hashes
+    assert result.method_admitted is False
+
+
+def test_missing_registered_evidence_root_is_unknown(tmp_path: Path) -> None:
+    registration = _registration(tmp_path)
+    registration.evidence_root.rename(tmp_path / "removed")
+    result = _auditor(registration).audit("registered-initial")
+    assert result.status == "UNKNOWN"
+    assert "registered_evidence_missing" in result.reasons
+
+
+def test_missing_exact_protocol_file_is_unknown(tmp_path: Path) -> None:
+    registration = _registration(tmp_path)
+    registration.protocol_path.unlink()
+    result = _auditor(registration).audit("registered-initial")
+    assert result.status == "UNKNOWN"
+    assert "registered_protocol_missing" in result.reasons
+
+
+@pytest.mark.parametrize("location", ["root", "raw-file", "raw-directory", "protocol"])
+def test_symlinks_cannot_replace_registered_evidence(tmp_path: Path, location: str) -> None:
+    registration = _registration(tmp_path)
+    external = tmp_path / "external"
+    external.mkdir()
+    (external / "secret.json").write_text("{}")
+    if location == "root":
+        registration.evidence_root.rename(external / "original")
+        registration.evidence_root.symlink_to(external / "original", target_is_directory=True)
+    elif location == "raw-file":
+        (registration.evidence_root / "raw.json").symlink_to(external / "secret.json")
+    elif location == "raw-directory":
+        (registration.evidence_root / "raw").symlink_to(external, target_is_directory=True)
+    else:
+        payload = registration.protocol_path.read_bytes()
+        registration.protocol_path.unlink()
+        (external / "protocol.json").write_bytes(payload)
+        registration.protocol_path.symlink_to(external / "protocol.json")
+    result = _auditor(registration).audit("registered-initial")
+    assert result.status == "INVALID"
+    assert "registered_path_symlink" in result.reasons
+    assert result.verified_scope is None
+
+
+@pytest.mark.parametrize("payload", ["null", "{", '{"status":"VALID"}'])
+def test_malformed_protocol_claims_are_invalid(tmp_path: Path, payload: str) -> None:
+    registration = _registration(tmp_path)
+    registration.protocol_path.write_text(payload)
+    result = _auditor(registration).audit("registered-initial")
+    assert result.status == "INVALID"
+    assert "initial_protocol_invalid" in result.reasons
+
+
+def test_changed_protocol_content_under_original_hash_is_invalid(tmp_path: Path) -> None:
+    registration = _registration(tmp_path)
+    payload = json.loads(registration.protocol_path.read_text())
+    payload["spec"]["tcap_s"] = 130
+    _write(registration.protocol_path, payload)
+    result = _auditor(registration).audit("registered-initial")
+    assert result.status == "INVALID"
+    assert "initial_protocol_invalid" in result.reasons
+
+
+@pytest.mark.parametrize("stage", ["FINAL", "v1"])
+def test_rehashed_non_v2_initial_protocol_is_not_admitted(tmp_path: Path, stage: str) -> None:
+    registration = _registration(tmp_path)
+    payload = json.loads(registration.protocol_path.read_text())
+    if stage == "FINAL":
+        payload["stage"] = "FINAL"
+    else:
+        payload["spec"]["schema_version"] = "rgbd.research.v1"
+        for name in (
+            "role_bundle_hash",
+            "selection_manifest_hash",
+            "selected_b0_period_s",
+            "budget_selection_rule_hash",
+            "resource_plan_hash",
+        ):
+            payload["spec"].pop(name)
+    payload["content_hash"] = content_digest({"spec": payload["spec"], "stage": payload["stage"]})
+    _write(registration.protocol_path, payload)
+    result = _auditor(registration).audit("registered-initial")
+    assert result.status == "INVALID"
+    assert "requires_v2_initial_protocol" in result.reasons
+
+
+def test_method_scope_preserves_missing_actual_prerequisites(tmp_path: Path) -> None:
+    result = _auditor(_registration(tmp_path)).audit("registered-initial", scope="METHOD")
+    assert result.status == "UNKNOWN"
+    assert result.initial_source_status == "UNKNOWN"
+    assert {
+        "method_risk_source_verifier_unavailable",
+        "method_weight_selection_verifier_unavailable",
+        "execution_owner_registration_unavailable",
+        "initial_source_missing",
+    } <= set(result.reasons)
+    assert result.method_admitted is False
+    assert result.execution_admitted is False
+
+
+def test_registered_source_and_returned_inventory_are_isolated(tmp_path: Path) -> None:
+    registration = _registration(tmp_path)
+    input_sources = dict(registration.current_source_hashes)
+    copied = InitialSourceRegistration(
+        registration.evidence_root,
+        registration.protocol_path,
+        registration.current_role_binding,
+        input_sources,
+    )
+    registrations = {"registered-initial": copied}
+    auditor = InitialSourceAdmissionAuditor(registrations)
+    input_sources.clear()
+    registrations.clear()
+    first = auditor.audit("registered-initial")
+    assert first.status == "UNKNOWN"
+    assert first.current_source_hashes
+    with pytest.raises(TypeError):
+        first.raw_file_hashes["fake"] = "0" * 64  # type: ignore[index]
+    with pytest.raises(FrozenInstanceError):
+        first.status = "VALID"  # type: ignore[misc]
+    second = auditor.audit("registered-initial")
+    assert second.raw_file_hashes == first.raw_file_hashes
+
+
+def test_opaque_valid_callback_cannot_be_registered(tmp_path: Path) -> None:
+    with pytest.raises(TypeError):
+        InitialSourceAdmissionAuditor(
+            {"registered-initial": _registration(tmp_path)},
+            verifier=lambda _: {"accepted": True, "status": "VALID"},  # type: ignore[call-arg]
+        )
+
+
+def test_rehashed_summary_claim_cannot_replace_missing_actual_runs(tmp_path: Path) -> None:
+    registration = _registration(tmp_path)
+    summary = {
+        "schema_version": "ced.pilot-stage.v1",
+        "protocol_version": "ced.research.v2",
+        "stage": "foundation",
+        "scope": "UNVERIFIED",
+        "execution_mode": "REAL_RUNTIME",
+        "status": "VALID",
+        "accepted": True,
+        "success": 120,
+        "freeze_ready": True,
+    }
+    summary["content_hash"] = content_digest(summary)
+    _write(registration.evidence_root / "summary.json", summary)
+    result = _auditor(registration).audit("registered-initial")
+    assert result.status != "VALID"
+    assert result.verified_scope is None
+    assert result.method_admitted is False
+    assert result.execution_admitted is False
+
