+def test_software_spec_comparison_checks_every_field_without_granting_admission(
+    tmp_path: Path,
+) -> None:
+    registration = _registration(tmp_path)
+    frozen = FrozenProtocol.model_validate_json(registration.protocol_path.read_bytes())
+    # This pure comparison does not reconstruct original sources or grant acceptance.
+    admission._assert_initial(
+        frozen,
+        frozen.spec,
+        registration.current_role_binding.bundle.digest(),
+    )
+    with pytest.raises(admission._AuditFailure, match="initial_derived_spec_mismatch"):
+        admission._assert_initial(
+            frozen,
+            frozen.spec.model_copy(update={"statistics_seed": 7}),
+            registration.current_role_binding.bundle.digest(),
+        )
+    with pytest.raises(admission._AuditFailure, match="current_role_bundle_mismatch"):
+        admission._assert_initial(frozen, frozen.spec, "0" * 64)
+    actual = _auditor(registration).audit("registered-initial")
+    assert actual.status == "UNKNOWN"
+    assert actual.verified_scope is None
+
