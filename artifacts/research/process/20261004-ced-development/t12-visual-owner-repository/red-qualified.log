    def test_two_sqlite_connections_restart_and_conflicting_owner_race(tmp_path):
        path = tmp_path / "event.db"
        first, second = SQLiteEventAutonomyRepository(path), SQLiteEventAutonomyRepository(path)
        data = values()
        original, checkpoint = data["original"], data["source_checkpoint"]
        state = VerificationBudgetState(3, 2, 0, original.verification_deadline_at, VerificationBudget(3, 2, 3, 40.0))
        retry = RecoveryBudget(budget_id="pool", task_id=original.identity.task_id, remaining_retries=2, retry_deadline=original.verification_deadline_at)
