+def _camera_hash(observation: dict[str, Any]) -> str:
+    return digest(
+        dict(
+            schema_version="visual.rgbd.camera-source-descriptor.v1",
+            **{
+                name: observation[name]
+                for name in (
+                    "source",
+                    "width",
+                    "height",
+                    "intrinsics",
+                    "camera_to_world",
+                    "depth_convention",
+                    "calibration_version",
+                )
+            },
+        )
+    )
