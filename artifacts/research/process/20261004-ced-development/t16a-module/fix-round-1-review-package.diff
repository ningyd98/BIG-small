+def noninferiority_status(success: EffectEstimate, safety: EffectEstimate) -> GoalStatus:
+    """明确越界为 FAIL，跨界未知为证据不足，不把劣于改成不确定。"""
+    if noninferiority_passes(success, safety):
+        return "PASS"
+    if (success.one_sided_upper95 is not None and success.one_sided_upper95 <= -0.03) or (
+        safety.one_sided_lower95 is not None and safety.one_sided_lower95 > 0.01
+    ):
+        return "FAIL"
+    return "INSUFFICIENT_EVIDENCE"
 
 
