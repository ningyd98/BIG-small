+@dataclass(frozen=True)
+class GoalVerdict:
+    """明确区分数学软件判定、未执行和实际来源验收状态。"""
+
+    goal_id: str
+    status: GoalStatus
+    estimate: object
+    reasons: tuple[str, ...]
+    evidence_scope: str = field(default="UNVERIFIED", kw_only=True)
