+GoalStatus = Literal["PASS", "FAIL", "INSUFFICIENT_EVIDENCE", "NOT_RUN"]
+GOAL_IDS = ("G0", "G1", "G2", "G2a", "G3", "G4", "G5", "C1", "C2")
+CORE_METHODS = ("JOINT", "B0", "B1", "B2", "NO_UNCERTAINTY", "NO_TIME_VALIDITY", "NO_LOCAL_REPAIR")
