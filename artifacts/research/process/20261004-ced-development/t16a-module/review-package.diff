+                    outcome,
+                    provenance,
+                    CostSnapshot(model_requests=calls, cloud_model_requests=calls),
+                    120.0,
+                    None,
+                    (),
+                    (),
+                    (),
+                    {},
+                    run_status="FAILED",
+                )
+            )
+    return result
+
+
+def test_bootstrap_resamples_groups_not_frames():
