+@pytest.mark.parametrize("bound", ["workspace_min_m", "workspace_max_m"])
+def test_registered_workspace_lists_cannot_mutate_reconstructed_labels(
+    tmp_path: Path, bound: str
+) -> None:
+    from cloud_edge_robot_arm.research.risk_sources import RiskSourceAuditor
+
+    registration, directory, _, _ = registered_fixture(tmp_path)
+    minimum = [-0.85, -0.85, 0.0]
+    maximum = [0.85, 0.85, 1.2]
+    criteria = replace(
+        registration.raw_registration.criteria,
+        workspace_min_m=minimum,
+        workspace_max_m=maximum,
+    )
+    raw = replace(registration.raw_registration, criteria=criteria)
+    replay = RiskSourceAuditor({"raw": raw}).audit("raw", scope="RAW_EXECUTION")
+    assert replay.status == "VALID", replay.reasons
+    json_file(
+        directory / "summary.json", {"outcome": dict(replay.case_results[0]["physical_outcome"])}
+    )
+    case = replace(raw.cases[0], original_file_hashes=hashes(directory))
+    registration = replace(registration, raw_registration=replace(raw, cases=(case,)))
+    owner = api().RiskSupervisionAuditor({"source": registration})
+    before = owner.audit("source")
+    assert before.diagnostic_status == "VALID", before.reasons
+    assert len(before.rows) == 2
+    original_hashes = hashes(directory)
+
+    if bound == "workspace_min_m":
+        minimum[2] = 0.7
+    else:
+        maximum[2] = 0.001
+
+    assert hashes(directory) == original_hashes
+    after = owner.audit("source")
+    assert after.diagnostic_status == before.diagnostic_status, after.reasons
+    assert after.rows == before.rows
+    assert after.counts == before.counts
+    assert after.original_file_hashes == before.original_file_hashes
+    assert after.status == after.actual_source_status == "UNKNOWN"
+    frozen = registration.raw_registration.criteria
+    assert type(frozen.workspace_min_m) is type(frozen.workspace_max_m) is tuple
+    assert frozen.workspace_min_m == (-0.85, -0.85, 0.0)
+    assert frozen.workspace_max_m == (0.85, 0.85, 1.2)
+
