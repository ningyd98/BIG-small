+def test_public_replacements_are_typed_detached_and_unique():
+    result = build()
+    with pytest.raises(ValueError):
+        replace(result, replacements=[result.replacements[0], result.replacements[0]])
+    with pytest.raises(ValueError):
+        replace(result.replacements[0], current_preconditions=[("gripper_open", "PASS", True, [])])
+    with pytest.raises(ValueError):
+        replace(result.replacements[0], original_requirements=object())
+    clones = list(result.replacements)
+    copied = replace(result, replacements=clones)
+    digest = copied.digest()
+    clones.clear()
+    assert copied.digest() == digest and len(copied.replacements) == 2
+
