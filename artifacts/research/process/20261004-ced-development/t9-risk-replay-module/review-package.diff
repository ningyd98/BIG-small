+def test_nonconstant_balanced_fit_matches_symmetric_logistic_reference():
+    allocations, rows = numeric_fixture()
+    for row in rows:
+        index = int(row["sample_id"].split("-")[-1])
+        row["online_features"]["depth_median_m"] = 0.75 if index % 2 else 0.25
+    result = replay(allocations, rows)
+    for candidate in result["candidate_results"]:
+        model = candidate["model"]
+        assert model["means"][1] == 0.5
+        assert model["scales"][1] == 0.25
+        # Literal reference from the independent symmetric one-dimensional recurrence.
+        assert model["weights"][1] == pytest.approx(3.1078554459275782, abs=1e-12)
+        assert model["intercept"] == pytest.approx(0.0, abs=1e-12)
+        assert candidate["selection_brier"] == 0.0
+        assert candidate["test_brier"] == 0.0
+        assert [r["failure_probability"] for r in candidate["selection_results"]] == [
+            0.0,
+            1.0,
+            0.0,
+            1.0,
+        ]
+
