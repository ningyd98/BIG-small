+    contracts = {}
+    for step in context.active_contract.steps:
+        if step.step_id in context.checkpoint.completed_step_ids:
+            continue
+        pre = (ConditionSpec("target_visible", "obj-1"),)
+        post = (ConditionSpec("object_held", "obj-1"),)
+        visual = VisualEvidence(
