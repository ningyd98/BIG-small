+def test_remote_context_is_intent_only_with_complete_proof_remaining_local(tmp_path, monkeypatch):
+    adapter, wire, _, _, source, request, *_ = setup(tmp_path, monkeypatch)
+    request = request.model_copy(update={"current_robot_state": {"internal-only": "private-state"}})
+    result = adapter.replan(request)
+    assert result.outcome == "REPLANNED"
+    body = json.loads(wire.requests[0])
+    envelope = json.loads(
+        body["messages"][1]["content"][0]["text"].split("\nROLE_REPAIR_CONTEXT=")[1].split("\n")[0]
+    )
+    assert set(envelope) == {
+        "schema_version",
+        "binding_hash",
+        "request",
+        "window",
+        "frame",
+        "context_hash",
+        "source_hash",
+        "bundle_hash",
+        "prompt_schema_hash",
+        "authorized_steps",
+        "failure_kind",
+    }
+    assert envelope["request"] == {"binding_hash": api().digest(request)}
+    assert envelope["frame"] == {
+        "binding_hash": api().digest(source.context.online_evidence.observation.evidence())
+    }
+    assert all(set(step) == {"step_id", "skill"} for step in envelope["authorized_steps"])
+    assert envelope["failure_kind"] == "STEP_REPAIR_REQUIRED"
+    assert b"private-state" not in wire.requests[0]
+    for field in (
+        "parameters",
+        "checkpoint",
+        "robot_state",
+        "visual_facts",
+        "dependencies",
+        "action_evidence",
+        "preconditions",
+        "postconditions",
+        "camera_to_world",
+    ):
+        assert field not in json.dumps(envelope)
+    # Full original conditions still exist locally for canonical validation and grounding.
+    assert source.action_evidence["grasp"].preconditions
+    assert source.action_evidence["grasp"].postconditions
+    assert adapter.last_binding_hash == envelope["binding_hash"]
