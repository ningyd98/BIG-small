+def test_formal_assignment_cannot_be_demoted_by_provenance_phase(scene_pool):
+    original = record(assignment(scene_pool), "BLOCKED")
+    with pytest.raises(ValueError, match="formal|phase"):
+        replace(
+            original,
+            provenance=original.provenance.model_copy(update={"split_role": "selection"}),
+            duration_penalized_s=0.001,
+            frozen_tcap_s=None,
+        )
+
+
+def test_supplied_protocol_validates_even_rehashed_nonformal_provenance(scene_pool):
+    from cloud_edge_robot_arm.datasets.rgbd.models import content_digest
+
+    original = record(assignment(scene_pool), "BLOCKED")
+    payload = original.to_payload(protocol=frozen(scene_pool))
+    payload.pop("content_hash")
+    payload["provenance"]["split_role"] = "selection"
+    payload["duration_penalized_s"] = 0.001
+    payload["frozen_tcap_s"] = None
+    payload["content_hash"] = content_digest(payload)
+    with pytest.raises(ValueError, match="formal|phase"):
+        assignment_api().episode_record_from_payload(payload, protocol=frozen(scene_pool))
