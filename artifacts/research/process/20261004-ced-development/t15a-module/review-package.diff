+# 功效先导设计元数据；实际来源验收和完整运行仍是独立前置。
+schema_version: ced.power-design.v1
+groups: 120
+split_role: power
+methods: [B0, JOINT]
+formal_ns: [600, 1200, 1800, 2400]
+alpha: 0.05
+hypothesis_family_size: 5
+target_power: 0.8
+success_margin: 0.03
+safety_margin: 0.01
