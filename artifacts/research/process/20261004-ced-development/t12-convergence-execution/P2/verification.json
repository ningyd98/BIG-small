{
  "env": {
    "PYTHONPATH": "src:.",
    "PYTHONDONTWRITEBYTECODE": "1",
    "MYPYPATH": "src"
  },
  "verification": {
    "RED": {
      "argv": [
        ".venv/bin/python",
        "-m",
        "pytest",
        "-q",
        "-p",
        "no:cacheprovider",
        "--basetemp=/tmp/bigsmall-t12-p2-red",
        "tests/test_native_references.py",
        "tests/test_native_calibration_source.py",
        "-k",
        "transport_displacement or fixed_goal_zero or mutable_grasp or native_timing or full_future_wall",
        "--junitxml=artifacts/research/process/20261004-ced-development/t12-convergence-execution/P2/RED.junit.xml"
      ]
    },
    "GREEN": {
      "argv": [
        ".venv/bin/python",
        "-m",
        "pytest",
        "-q",
        "-p",
        "no:cacheprovider",
        "--basetemp=/tmp/bigsmall-t12-p2-green",
        "tests/test_native_references.py",
        "tests/test_native_calibration_source.py",
        "--junitxml=artifacts/research/process/20261004-ced-development/t12-convergence-execution/P2/GREEN.junit.xml"
      ]
    },
    "formatter": {
      "argv": [
        ".venv/bin/python",
        "-m",
        "ruff",
        "format",
        "src/cloud_edge_robot_arm/vision/native_references.py",
        "src/cloud_edge_robot_arm/vision/native_calibration.py",
        "src/cloud_edge_robot_arm/research/native_geometry_calibration.py",
        "tests/test_native_references.py",
        "tests/test_native_calibration_source.py"
      ]
    },
    "ruff_check": {
      "argv": [
        ".venv/bin/python",
        "-m",
        "ruff",
        "check",
        "src/cloud_edge_robot_arm/vision/native_references.py",
        "src/cloud_edge_robot_arm/vision/native_calibration.py",
        "src/cloud_edge_robot_arm/research/native_geometry_calibration.py",
        "tests/test_native_references.py",
        "tests/test_native_calibration_source.py"
      ]
    },
    "ruff_format_check": {
      "argv": [
        ".venv/bin/python",
        "-m",
        "ruff",
        "format",
        "--check",
        "src/cloud_edge_robot_arm/vision/native_references.py",
        "src/cloud_edge_robot_arm/vision/native_calibration.py",
        "src/cloud_edge_robot_arm/research/native_geometry_calibration.py",
        "tests/test_native_references.py",
        "tests/test_native_calibration_source.py"
      ]
    },
    "mypy": {
      "argv": [
        ".venv/bin/python",
        "-m",
        "mypy",
        "--cache-dir=/tmp/bigsmall-t12-p2-mypy",
        "--follow-imports=silent",
        "src/cloud_edge_robot_arm/vision/native_references.py",
        "src/cloud_edge_robot_arm/vision/native_calibration.py",
        "src/cloud_edge_robot_arm/research/native_geometry_calibration.py"
      ]
    }
  }
}
