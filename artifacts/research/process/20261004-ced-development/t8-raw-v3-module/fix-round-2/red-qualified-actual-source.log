    def test_actual_camera_timestamp_is_inside_the_original_acquisition_bracket(offset_us, want):
        envelope, records = fixture()
        frame = records.frames[0]
        payload = dict(frame.observation_payload)
        payload["captured_at"] = (
            RGBDObservation.model_validate(payload).captured_at + timedelta(microseconds=offset_us)
        ).isoformat()
        payload["checksum_sha256"] = ""
        observation = RGBDObservation.model_validate(payload)
        updated_frame = replace(frame, observation_payload=observation.model_dump(mode="json"))
        joins = tuple(
            replace(row, checksum_sha256=observation.checksum_sha256)
            if row.acquisition_id == frame.acquisition_id
            else row
            for row in records.joins
        )
        view = api().validate_raw_episode_v3(
            envelope, replace(records, frames=(updated_frame, *records.frames[1:]), joins=joins)
        )
