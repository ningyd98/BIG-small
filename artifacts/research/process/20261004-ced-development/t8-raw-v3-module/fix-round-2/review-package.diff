+@pytest.mark.parametrize(
+    "target,bias,gain,bounds,output,want",
+    [
+        (1.0, 0.0, 20.0, (-3.0, 3.0), 0.10, "COMPLETE"),
+        (-1.0, 0.0, 20.0, (-3.0, 3.0), -0.10, "COMPLETE"),
+        (0.04, 0.0, 20.0, (-3.0, 3.0), 0.04, "COMPLETE"),
+        (1.0, 4.0, 20.0, (-0.25, 0.25), 0.25, "COMPLETE"),
+        (-1.0, -4.0, 20.0, (-0.25, 0.25), -0.25, "COMPLETE"),
+        (1.0, 0.0, 20.0, (-3.0, 3.0), 1.0, "INVALID"),
+    ],
+)
+def test_original_control_replay_uses_real_displacement_limit_before_bias_and_range(
+    target, bias, gain, bounds, output, want
+):
+    envelope, records = fixture()
+    command = replace(
+        records.commands[0],
+        command_payload={
+            **dict(records.commands[0].command_payload),
+            "target_positions_rad": [target] * 7,
+            "applied_target_positions_rad": [target] * 7,
+        },
+    )
+    final = records.physics[-1]
+    actual_control = {
+        **dict(final.control_payload),
+        "applied_joint_targets_rad": [target] * 7,
+        "pre_gravity_bias_nm": [bias] * 7,
+        "actuator_gains": [gain] * 7,
+        "actuator_ctrl_ranges": [bounds] * 7,
+        "control_rad": [output] * 7,
+    }
+    view = api().validate_raw_episode_v3(
+        envelope,
+        replace(
+            records,
+            commands=(command,),
+            physics=(*records.physics[:-1], replace(final, control_payload=actual_control)),
+        ),
+    )
+    assert view.status == want, view.reasons
+    assert view.counts["physics_expected"] == view.counts["physics_recorded"] == 121
+    assert view.counts["commands_expected"] == view.counts["commands_recorded"] == 1
+
+
+@pytest.mark.parametrize("offset_us,want", [(10, "COMPLETE"), (-1, "INVALID"), (1001, "INVALID")])
+def test_actual_camera_timestamp_is_inside_the_original_acquisition_bracket(offset_us, want):
+    envelope, records = fixture()
+    frame = records.frames[0]
+    payload = dict(frame.observation_payload)
+    payload["captured_at"] = (
+        RGBDObservation.model_validate(payload).captured_at + timedelta(microseconds=offset_us)
+    ).isoformat()
+    payload["checksum_sha256"] = ""
+    observation = RGBDObservation.model_validate(payload)
+    updated_frame = replace(frame, observation_payload=observation.model_dump(mode="json"))
+    joins = tuple(
+        replace(row, checksum_sha256=observation.checksum_sha256)
+        if row.acquisition_id == frame.acquisition_id
+        else row
+        for row in records.joins
+    )
+    view = api().validate_raw_episode_v3(
+        envelope, replace(records, frames=(updated_frame, *records.frames[1:]), joins=joins)
+    )
+    assert view.status == want, view.reasons
+    assert view.utc_mapping == "UNAVAILABLE"
+    assert view.counts["allocated_acquisitions"] == view.counts["recorded_acquisitions"] == 2
+    assert (
+        updated_frame.observation_payload["captured_at"]
+        == observation.model_dump(mode="json")["captured_at"]
+    )
+
+
+def test_camera_original_missing_end_boundary_is_incomplete_without_inventing_a_return():
+    envelope, records = fixture()
+    frame = records.frames[0]
+    intervals = tuple(
+        replace(
+            interval,
+            end=None,
+            end_step=None,
+            end_sim_time_s=None,
+            disposition="PARTIAL",
+            error="acquisition-return-not-recorded",
+        )
+        if interval.interval_id == frame.interval_id
+        else interval
+        for interval in records.intervals
+    )
+    view = api().validate_raw_episode_v3(envelope, replace(records, intervals=intervals))
+    assert view.status == "INCOMPLETE", view.reasons
+    assert "frame_acquisition_end_boundary_unavailable" in view.reasons
+    assert view.counts["allocated_acquisitions"] == view.counts["recorded_acquisitions"] == 2
+
+
+def test_reversed_camera_utc_boundaries_are_invalid_even_with_monotonic_order():
+    envelope, records = fixture()
+    frame = records.frames[0]
+    original = next(i for i in records.intervals if i.interval_id == frame.interval_id)
+    reversed_interval = replace(
+        original,
+        end=replace(original.end, utc_at=original.start.utc_at - timedelta(microseconds=1)),
+    )
+    view = api().validate_raw_episode_v3(
+        envelope,
+        replace(
+            records,
+            intervals=tuple(
+                reversed_interval if row.interval_id == frame.interval_id else row
+                for row in records.intervals
+            ),
+        ),
+    )
+    assert view.status == "INVALID", view.reasons
+
+
+@pytest.mark.parametrize("missing_end", [False, True])
+def test_original_during_action_camera_end_is_preserved_or_explicitly_incomplete(missing_end):
+    envelope, records = fixture()
+    frame = records.frames[-1]
+    interval = next(row for row in records.intervals if row.interval_id == frame.interval_id)
+    inside = clock_interval(interval, "acq-during", "ACQUISITION", 121, 121, 215000000, 215500000)
+    if missing_end:
+        inside = replace(
+            inside,
+            end=None,
+            end_step=None,
+            end_sim_time_s=None,
+            disposition="PARTIAL",
+            error="actual-camera-return-missing",
+        )
+    payload = dict(frame.observation_payload)
+    payload.update(
+        frame_id="during-original",
+        observation_id="during-original",
+        captured_at=inside.start.utc_at.isoformat(),
+        checksum_sha256="",
+    )
+    observation = RGBDObservation.model_validate(payload)
+    file_hashes = {"during/" + name: sha for name, sha in frame.file_hashes.items()}
+    actual_frame = replace(
+        frame,
+        acquisition_id="acq-during",
+        interval_id="acq-during",
+        observation_payload=observation.model_dump(mode="json"),
+        file_hashes=file_hashes,
+    )
+    during_join = replace(
+        records.joins[-1],
+        acquisition_id="acq-during",
+        relation="DURING_ACTION",
+        observation_id=observation.observation_id,
+        checksum_sha256=observation.checksum_sha256,
+    )
+    view = api().validate_raw_episode_v3(
+        replace(
+            envelope,
+            allocated_acquisition_ids=(*envelope.allocated_acquisition_ids, "acq-during"),
+            original_file_hashes={**dict(envelope.original_file_hashes), **file_hashes},
+        ),
+        renumber(
+            replace(
+                records,
+                intervals=(*records.intervals, inside),
+                frames=(*records.frames, actual_frame),
+                joins=(*records.joins, during_join),
+            )
+        ),
+    )
+    assert view.status == ("INCOMPLETE" if missing_end else "COMPLETE"), view.reasons
+    assert view.counts["recorded_acquisitions"] == 3
