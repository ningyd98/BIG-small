        intervals, physics = [], []
    
        def next_seq():
            nonlocal seq
            seq += 1
            return seq
    
        def pair(ns):
            return m.ClockPairV3("clock-1", descriptor.digest(), ns + 1, ns, NOW + timedelta(microseconds=ns // 1000), ns + 100)
    
        def interval(name, kind, n0, n1, t0, t1, disposition="COMPLETE", error=None):
            row = m.RawIntervalV3(name, next_seq(), identity, kind, pair(t0), pair(t1) if t1 is not None else None,
                                  n0, n1, n0 / 240, n1 / 240 if n1 is not None else None, disposition, error)
            intervals.append(row)
            return row
    
        interval("settle", "SETTLE", 0, 120, 0, 12_100_000)
        shift = 6_000_000_000 if late_action else 0
        interval("attempt", "EXECUTOR_ATTEMPT", 120, 121, 210_000_000 + shift, 220_000_000 + shift)
        for n in range(1, 122):
            base = (n - 1) * 100_000 if n <= 120 else 211_000_000 + shift
            interval(f"control-{n}", "CONTROL_APPLY", n - 1, n - 1, base + 1000, base + 2000)
            interval(f"step-{n}", "PHYSICS_STEP", n - 1, n, base + 3000, base + 90_000)
            physics.append(m.RawPhysicsStepV3(next_seq(), identity, n, hash_payload(state(n - 1)), state(n), control(n),
