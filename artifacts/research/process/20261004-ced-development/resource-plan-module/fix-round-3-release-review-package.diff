+def test_public_compiler_cannot_admit_edited_remote_fees(tmp_path, monkeypatch):
+    # The physical auditor and auxiliary costs are SOFTWARE_ONLY stubs. The
+    # public compiler and every case's original ledger/wire reader remain real.
+    import json
+    import shutil
+
+    from cloud_edge_robot_arm.research import freeze_evidence
+
+    base = {
+        "available": True,
+        "errors": [],
+        "pools": {"foundation": [{"scene": {"group_id": "SOFTWARE_ONLY"}}]},
+        "role_bundle_hash": "b" * 64,
+        "cloud_model_snapshot_hash": "a" * 64,
+        "selected_period_s": 2.0,
+        "evidence_hash": "c" * 64,
+    }
+    original = tmp_path / "SOFTWARE_ONLY-ledger-template"
+    original.mkdir()
+    request_fixture(original)
+    audits = {}
+    for stage, count in (("foundation", 120), ("selection", 480)):
+        stage_root = tmp_path if stage == "foundation" else tmp_path / "selection-evidence"
+        rows = []
+        for index in range(count):
+            assignment = f"{stage}-{index:04d}"
+            case = stage_root / "cases" / assignment
+            shutil.copytree(original, case)
+            (case / "requests.json").rename(case / "costs.json")
+            (case / "wire.json").rename(case / "wire-index.json")
+            rows.append(
+                {
+                    "assignment_id": assignment,
+                    "scope": "REAL_RUNTIME",
+                    "success": stage == "foundation" and index == 0,
+                    "wall_duration_s": 100.0,
+                }
+            )
+        audits[stage] = {**base, "cases": rows}
+    monkeypatch.setattr(freeze_evidence, "audit_ced_pilot_stage", lambda root, stage: audits[stage])
+    monkeypatch.setattr(
+        api(),
+        "_read_resource_phase",
+        lambda *args, **kwargs: {**amount(), "coverage": {"group_ids": ["SOFTWARE_ONLY-aux"]}},
+    )
+    (tmp_path / "protocol-evidence").mkdir()
+    (tmp_path / "protocol-evidence/opportunities.json").write_text(
+        json.dumps([{"seed": {"opportunity_id": "SOFTWARE_ONLY-opportunity"}}])
+    )
+    auxiliary = tmp_path / "resource-evidence"
+    for phase in api().AUXILIARY_PHASES:
+        (auxiliary / phase).mkdir(parents=True)
+    plan = api().compile_resource_plan(
+        tmp_path, declared_ceilings=ceilings(), auxiliary_cost_evidence=auxiliary
+    )
+    assert plan["available"] is False and plan["budget_status"] == "INCOMPLETE"
+    assert plan["totals"]["worst"]["monetary_cost"] is None
+    assert plan["original_denominators"] == {"selection": 480, "foundation": 120}
+    assert plan["actual_research_status"] == "NOT_RUN" and plan["physical_acceptance"] is False
+    diagnostics = plan["billing_diagnostics"]
+    assert len(diagnostics["foundation"]) == 120 and len(diagnostics["selection"]) == 480
+    assert diagnostics["foundation"][0]["declared_monetary_cost"] == 2.0
+    assert diagnostics["foundation"][0]["billing_status"] == "REMOTE_BILLING_UNAVAILABLE"
+
