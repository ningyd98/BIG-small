+@pytest.mark.parametrize("declared_fee", [0.0, 0.5, 10000.0])
+def test_remote_declared_ledger_fee_is_not_independent_billing(tmp_path, declared_fee):
+    import json
+
+    rows, _ = request_fixture(tmp_path)
+    for row in rows:
+        row["monetary_cost"] = declared_fee
+    (tmp_path / "requests.json").write_text(json.dumps(rows))
+    result = api()._read_request_costs(tmp_path, "requests.json", "wire.json")
+    assert result["monetary_cost"] is None
+    assert result["billing_status"] == "REMOTE_BILLING_UNAVAILABLE"
+    assert result["declared_monetary_cost"] == declared_fee * 4
+    assert result["declared_monetary_costs_by_request"] == {
+        row["request_id"]: declared_fee for row in rows
+    }
+    assert result["cloud_model_requests"] == 4 and result["original_attempts"] == 4
