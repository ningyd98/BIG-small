+        or recomputed.get("available") is not True
+        or recomputed.get("budget_status") != "WITHIN_DECLARED_CEILINGS"
+        or recomputed.get("physical_acceptance") is not False
+        or recomputed.get("actual_research_status") != "NOT_RUN"
