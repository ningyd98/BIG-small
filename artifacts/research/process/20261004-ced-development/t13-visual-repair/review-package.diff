+@pytest.mark.parametrize("changed", ["observation", "window", "dependency"])
+def test_rejected_provider_mutation_cannot_change_caller_frozen_objects(changed):
+    request, context, window, observation = fixture()
+    original = (observation.model_dump(), window.first_affected_step_id,
+                context.dependencies[0].physical_effect_id,
+                context.online_evidence.observation.model_dump())
+    def bad(request, window, observation, context):
+        result = provider(request, window, observation, context)
+        if changed == "observation":
+            object.__setattr__(observation, "calibration_version", "tampered")
+        elif changed == "window":
+            object.__setattr__(window, "first_affected_step_id", "tampered")
+        else:
+            object.__setattr__(context.dependencies[0], "physical_effect_id", "tampered")
+        return result
+    result = api().build_visual_repair(request, window, observation, context=context,
+                                      provider=bad, clock=lambda: NOW + timedelta(seconds=.2))
+    assert result.outcome == "PLANNER_FAILED" and not result.new_steps
+    assert (observation.model_dump(), window.first_affected_step_id,
+            context.dependencies[0].physical_effect_id,
+            context.online_evidence.observation.model_dump()) == original
+
+
+def test_candidate_publication_rechecks_the_final_clock_sample():
+    request, context, window, observation = fixture()
+    clock = iter(NOW + timedelta(seconds=value) for value in (.2, .3, 7, 7))
+    result = api().build_visual_repair(request, window, observation, context=context,
+                                      provider=provider, clock=lambda: next(clock))
+    assert result.outcome != "REPLANNED" and result.new_steps == []
