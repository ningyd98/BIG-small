+def _b_t3_terminal_fault(scoped, observed, repo, session, reads, variant, evidence):
+    """Fault actual SQL/queue/counter seams, never replace a positive decision."""
+    from cloud_edge_robot_arm.simulation_runtime import operational_lease
+
+    evidence.update(variant=variant, fired=False, events=[])
+    if variant == "commit_close":
+        connection_type = type(reads["job"])
+        real_execute = connection_type.execute
+
+        def execute(connection, sql, parameters=(), /):
+            result = real_execute(connection, sql, parameters)
+            if (not evidence["fired"] and sql.strip().rstrip(";").upper() == "COMMIT"
+                    and getattr(repo._transactions, "connection", None) is connection):
+                row = reads["job"].execute(
+                    "SELECT * FROM simulation_operational_leases_v1 WHERE job_id=?", (session.job_id,)
+                ).fetchone()
+                if row is not None and row["terminal_reason"] == "owned publication completed":
+                    evidence["fired"] = True
+                    evidence["events"].append({"kind": "TRUE_TERMINAL_COMMIT_THEN_SAME_CONNECTION_CLOSE",
+                        "resource_id": id(connection), "in_transaction_after_commit": connection.in_transaction,
+                        "durable_operational_row": dict(row), "thread": threading.get_ident()})
+                    assert connection.in_transaction is False
+                    connection.close()
+                    try:
+                        real_execute(connection, "SELECT 1")
+                    except sqlite3.ProgrammingError as error:
+                        evidence["actual_closed_connection_error"] = {"type": type(error).__name__, "message": str(error)}
+                        raise
+                    raise AssertionError("closed actual terminal connection executed SQL")
+            return result
+
+        scoped.setattr(connection_type, "execute", execute)
+        return
+    real_decide = operational_lease.OperationalLeaseSession._decide
+    release = threading.Event()
+    observed.release_events.append(release)
+    if variant == "confirm_timeout":
+        real_invalidate = operational_lease.OperationalLeaseSession.invalidate
+
+        def invalidate(actual, reason):
+            real_invalidate(actual, reason)
+            if actual is session and reason == "RPC wait cap exceeded" and evidence["fired"]:
+                evidence["events"].append({"kind": "ACTUAL_MAIN_RPC_TIMEOUT", "reason": reason})
+                release.set()
+
+        scoped.setattr(operational_lease.OperationalLeaseSession, "invalidate", invalidate)
+
+    def decide(actual, clock, request):
+        terminal = (request.kind == "confirm" and request.view is not None
+                    and request.view.purpose == "finalize_operational_publication")
+        consume = (request.kind == "consume" and request.source_reply is not None
+                   and request.source_reply.kind == "confirm"
+                   and request.source_reply.view.view.purpose == "finalize_operational_publication")
+        if actual is session and not evidence["fired"] and (
+                (variant == "confirm_timeout" and terminal) or (variant == "prior_bound" and consume)):
+            evidence["fired"] = True
+            if variant == "confirm_timeout":
+                evidence["events"].append({"kind": "ACTUAL_TERMINAL_REQUEST_DEQUEUED",
+                    "kind_requested": request.kind, "broker_thread": threading.get_ident()})
+                assert release.wait(timeout=session.wait_cap + 2), "actual RPC timeout did not release broker"
+                evidence["events"].append({"kind": "LATE_BROKER_RESUMED", "cancelled": request.cancelled.is_set()})
+            else:
+                previous = request.source_reply.segments[0]
+                raw = next(raw for actual_clock, raw, domain in observed.clocks
+                           if actual_clock is clock and domain == "D_lease")
+                evidence["events"].append({"kind": "ACTUAL_CONFIRM_CONSUMPTION_PRIOR_BOUND",
+                    "before_ns": raw.now, "prior_deadline_ns": previous.deadline.deadline_ns,
+                    "broker_thread": threading.get_ident()})
+                raw.now = previous.deadline.deadline_ns
+        try:
+            return real_decide(actual, clock, request)
+        except operational_lease.OperationalLeaseError as error:
+            if actual is session and evidence["fired"]:
+                evidence["events"].append({"kind": "ACTUAL_BROKER_DENIAL", "message": str(error)})
+            raise
+
+    scoped.setattr(operational_lease.OperationalLeaseSession, "_decide", decide)
+
