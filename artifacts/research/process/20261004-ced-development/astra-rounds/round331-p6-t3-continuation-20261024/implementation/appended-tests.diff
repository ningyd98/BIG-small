+    from cloud_edge_robot_arm.vision.worker_runtime import VisualWorkerRuntime
+    from cloud_edge_robot_arm.simulation_runtime.sqlite_repository import SQLiteSimulationJobRepository
+
+    if not public:
+        assert callable(getattr(VisualWorkerRuntime, "remaining_app_seconds", None)), (
+            "R331 planned missing remaining_app_seconds"
+        )
+        return
+    assert callable(getattr(SQLiteSimulationJobRepository, "get_publication_summary", None)), (
+        "R331 planned missing get_publication_summary"
+    )
+    from cloud_edge_robot_arm.simulation_runtime import models as runtime_models
+    from cloud_edge_robot_arm.simulation_workbench import models as public_models
+
+    summary = getattr(runtime_models, "PublicationSummary", None)
+    assert summary is not None, "R331 planned missing immutable PublicationSummary"
+    view = getattr(public_models, "PublicationStatusView", None)
+    assert view is not None, "R331 planned missing PublicationStatusView"
+    assert set(view.model_fields) == set(_b_t3_public_fields()), "R331 planned publication fields"
+    assert view.model_config.get("extra") == "forbid" and view.model_config.get("frozen") is True
+    for cls in (public_models.SimulationRunRecord, public_models.SimulationArtifactsResponse,
+                public_models.SimulationMetricsResponse, public_models.SimulationEventsResponse,
+                runtime_models.AttemptView):
+        assert "publication" in cls.model_fields, f"R331 planned missing {cls.__name__}.publication"
+    assert {"confirmed_succeeded", "unconfirmed_terminal"} <= set(public_models.BatchProgress.model_fields)
+    assert "publication_state" in public_models.BatchRecord.model_fields
+    assert "historical_payload" in public_models.TimelineEvent.model_fields
