+def _b_t3_public_readouts(scoped, worker, repo, job, *, accepted):
+    recovery = []
+    service, suppressed = _b_t3_service(scoped, worker, repo, recovery)
+    before = _b_t2_plain(repo.get_job(job.job_id))
+    stored_events = repo.list_events(job.run_id)
+    stored_metrics = repo.get_metrics(job.run_id)
+    paths = repo.get_artifacts(job.run_id)
+    # The isolated factory's genuine batch_id may be empty; retain it exactly.
+    repo.create_batch(batch_id=job.batch_id, manifest=job.manifest, run_ids=[job.run_id])
+    run = service.get_run(job.run_id)
+    attempts = service.attempts_for(job.run_id)
+    artifacts = service.artifacts_for(job.run_id)
+    metrics = service.metrics_for(job.run_id)
+    events = service.events_for(job.run_id)
+    batch = service.get_batch(job.batch_id)
+    summary = service.repository.get_publication_summary(job.run_id)
+    payload = summary.to_payload()
+    assert set(payload) == set(_b_t3_public_fields())
+    assert payload["schema_version"] == "simulation.publication-status.v1"
+    assert payload["recorded_sql_status"] == before["status"] == run.status.value == "SUCCEEDED"
+    assert payload["accepted"] is accepted
+    assert payload["historical_artifact_paths"] == paths == before["artifact_paths"]
+    assert payload["confirmed_artifact_paths"] == (paths if accepted else {})
+    assert payload["confirmation_state"] == "CONFIRMED" if accepted else payload["confirmation_state"] in {
+        "UNKNOWN", "UNCONFIRMED", "PENDING"}
+    for public in (run, artifacts, metrics, events, *attempts.attempts):
+        assert public.publication.model_dump(mode="json") == payload
+    assert artifacts.artifacts == (paths if accepted else {})
+    assert [item.model_dump(mode="json") for item in metrics.metrics] == stored_metrics
+    assert len(attempts.attempts) == 1 and attempts.attempts[0].result == "SUCCEEDED"
+    assert len(events.events) == len(stored_events)
+    for event, stored in zip(events.events, stored_events, strict=True):
+        assert event.event_type == stored.event_type and event.sequence == stored.sequence
+        if stored.event_type == "artifact_created":
+            assert event.historical_payload == stored.payload
+            assert event.payload == (stored.payload if accepted else {})
+        else:
+            assert event.payload == stored.payload
+    assert batch.progress.succeeded == 1
+    assert batch.progress.confirmed_succeeded == int(accepted)
+    assert batch.progress.unconfirmed_terminal == int(not accepted)
+    assert batch.publication_state == ("COMPLETE" if accepted else "INCOMPLETE")
+    assert repo.get_job(job.job_id).status.value == "SUCCEEDED"
+    assert _b_t2_plain(repo.get_job(job.job_id)) == before
+    assert len(recovery) == len(suppressed) == 1
+    assert service.dispatcher._thread is None
+    return {"summary": payload, "run": _b_t2_plain(run), "attempts": _b_t2_plain(attempts),
+            "artifacts": _b_t2_plain(artifacts), "metrics": _b_t2_plain(metrics),
+            "events": _b_t2_plain(events), "batch": _b_t2_plain(batch),
+            "startup_recovery": recovery, "suppressed_dispatcher_start": suppressed}, service
+
