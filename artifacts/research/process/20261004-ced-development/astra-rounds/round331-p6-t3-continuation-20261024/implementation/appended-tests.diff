+def _b_t3_service(scoped, worker, repo, recovery_records):
+    from cloud_edge_robot_arm.dashboard.event_stream import DashboardEventStream
+    from cloud_edge_robot_arm.simulation_runtime.recovery import ArtifactRecoveryService
+    from cloud_edge_robot_arm.simulation_runtime.service import SimulationRuntimeService
+
+    service = SimulationRuntimeService(artifact_root=worker.artifact_root,
+                                       database_path=repo.database_path,
+                                       event_stream=DashboardEventStream())
+    original_recover = ArtifactRecoveryService.recover_interrupted_jobs
+
+    def recover(instance):
+        result = original_recover(instance)
+        if instance.repository is service.repository:
+            recovery_records.append({"result": _b_t2_plain(result),
+                                     "local_publication_history": _b_t2_plain(instance.local_publication_history)})
+        return result
+
+    scoped.setattr(ArtifactRecoveryService, "recover_interrupted_jobs", recover)
+    suppressed_starts = []
+    scoped.setattr(service.dispatcher, "start", lambda: suppressed_starts.append("instance-start-suppressed"))
+    assert service.repository.database_path == repo.database_path
+    assert all(item.active_job_id == "" for item in service.dispatcher._workers)
+    return service, suppressed_starts
+
