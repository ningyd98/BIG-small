+def _b_t3_utc(scoped, at):
+    from datetime import datetime
+
+    class DateTimeMeta(type):
+        def __instancecheck__(cls, value):
+            return isinstance(value, datetime)
+
+    class ShiftedDateTime(datetime, metaclass=DateTimeMeta):
+        @classmethod
+        def now(cls, tz=None):
+            return at.replace(tzinfo=None) if tz is None else at.astimezone(tz)
+
+    names = ("vision.worker_runtime", "vision.worker_owner",
+             "vision.owner_registration", "vision.execution", "vision.supervision",
+             "simulation_runtime.worker", "repositories.event_autonomy.visual_bootstrap",
+             "repositories.event_autonomy.visual_supervision", "repositories.event_autonomy.visual_owner",
+             "repositories.event_autonomy.visual_verification", "repositories.event_autonomy.memory",
+             "repositories.event_autonomy.sqlite", "edge.recovery.verification_router",
+             "edge.recovery.lifecycle", "edge.evidence.conditions", "cloud.planning.pipeline")
+    for name in names:
+        module = importlib.import_module("cloud_edge_robot_arm." + name)
+        assert hasattr(module, "datetime"), name
+        scoped.setattr(module, "datetime", ShiftedDateTime)
+
+
+def _b_t3_external_utc(observation, contract, at):
+    from datetime import timedelta
+    from cloud_edge_robot_arm.cloud.planning.models import InitialPlanningRequest, SceneSummary
+    from cloud_edge_robot_arm.cloud.planning.pipeline import check_scene_sufficiency
+    from cloud_edge_robot_arm.edge.evidence.models import CommitContext, DecisionEnvelope
+    from cloud_edge_robot_arm.edge.evidence.validator import validate_decision_commit
+
+    rows = []
+    for milliseconds, valid in ((1000, True), (1001, False), (-5000, True), (-5001, False)):
+        raw = observation.model_dump(mode="json")
+        raw.update(captured_at=(at + timedelta(milliseconds=milliseconds)).isoformat(), checksum_sha256="")
+        external = type(observation).model_validate(raw)
+        value = InitialPlanningRequest(user_instruction=contract.user_instruction,
+            observation=external, scene=SceneSummary(scene_version=contract.scene_version))
+        reason = check_scene_sufficiency(value)
+        assert (reason is None) is valid
+        rows.append({"offset_ms": milliseconds, "reason": reason})
+    current = CommitContext(contract.task_id, observation.episode_id, observation.observation_id,
+                            contract.plan_version, contract.command_seq, contract.scene_version,
+                            "r331-external-context", "a" * 64, False)
+    decision = DecisionEnvelope("r331-external", contract.task_id, observation.episode_id,
+        observation.observation_id, contract.plan_version, contract.command_seq, contract.scene_version,
+        current.context_hash, current.candidate_set_hash, "CONTINUE", "CPU", "CPU",
+        at - timedelta(seconds=1), at)
+    verdict = validate_decision_commit(decision, current, at)
+    assert verdict.status == "INVALID" and "decision_future_or_expired" in verdict.reasons
+    return {"scene_boundaries": rows, "expired_external_decision": _b_t2_plain(verdict)}
+
