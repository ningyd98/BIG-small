+def _b_t3_exercise(monkeypatch, directory, backend, observed, callback, *,
+                   after=None, success=False, configure=None, initialize=None):
+    """Real protected factory and poll; only disclosed CPU outcome/physical seams."""
+    from dataclasses import replace
+    from cloud_edge_robot_arm.repositories.event_autonomy import InMemoryEventAutonomyRepository
+    from cloud_edge_robot_arm.simulation_runtime import operational_lease
+    from cloud_edge_robot_arm.vision import execution
+    from tests.test_visual_worker_factory import software_factory
+
+    directory.mkdir(parents=True, exist_ok=False)
+    outcomes, errors, reads, cpu_outcomes = [], [], {}, []
+    received = None
+    events = None
+
+    def during_episode(worker, repo, job, source_root):
+        runtime = received[0][3].worker_runtime
+        session = worker._operational_lease_session
+        assert runtime.source.event_repository is events and session is not None
+        try:
+            outcomes.append(callback(runtime, session, worker, repo, job, events, reads, observed))
+        except BaseException as error:
+            errors.append(error)  # Preserve the actual failure swallowed by worker settlement.
+            raise
+
+    with monkeypatch.context() as scoped:
+        data = software_factory(scoped, directory, during_episode=during_episode,
+                                during_initialize=initialize)
+        repo, job, worker, calls, received, backend_object, original_events = data
+        events = original_events
+        if backend == "memory":
+            original_events.close()
+            events = InMemoryEventAutonomyRepository()
+            worker.visual_event_repository = events
+        worker.operational_time_mode = "LOCAL_TEMPORAL_PUBLICATION_V1"
+        if success:
+            original_episode = execution.run_visual_episode
+            injected = {"success": True, "status": "SUCCESS", "online_reported_complete": True,
+                        "physical_success": True, "failure_reason": None, "terminal_reason": None}
+
+            def cpu_success(*args, **kwargs):
+                original = original_episode(*args, **kwargs)
+                before = asdict(original)
+                assert before["success"] is False and before["status"] == "FAILED"
+                assert before["failure_reason"] == before["terminal_reason"] == "SOFTWARE_FACTORY_ONLY"
+                controlled = replace(original, **injected)
+                following = asdict(controlled)
+                assert {k: v for k, v in before.items() if k not in injected} == {
+                    k: v for k, v in following.items() if k not in injected}
+                for key in ("measured_lift_m", "hold_s", "placed_stable_s", "elapsed_s",
+                            "executed_actions", "model_calls", "observation_count"):
+                    assert before[key] == following[key] == 0
+                assert before["verification_records"] == following["verification_records"] == ()
+                cpu_outcomes.append({"before": before, "injected_fields": injected, "after": following})
+                return controlled
+
+            scoped.setattr(execution, "run_visual_episode", cpu_success)
+        try:
+            # Independent readers are created before every tested authority/SQL lock.
+            reads["job"] = sqlite3.connect(repo.database_path)
+            reads["job"].row_factory = sqlite3.Row
+            if backend == "sqlite":
+                reads["event"] = sqlite3.connect(events.path)
+                reads["event"].row_factory = sqlite3.Row
+            if configure is not None:
+                configure(scoped, worker, repo, job, events, reads)
+            assert worker.poll_once()
+            if errors:
+                raise errors[0]
+            assert len(outcomes) == 1, repo.get_job(job.job_id).error_message
+            assert calls.count("episode") == calls.count("shutdown") == calls.count("raw_exit") == 1
+            if success:
+                assert len(cpu_outcomes) == 1
+            result = {"during_episode": outcomes[0], "cpu_outcomes": cpu_outcomes,
+                      "job": _b_t2_plain(repo.get_job(job.job_id)),
+                      "attempts": _b_t2_plain(repo.list_attempts(job.run_id)),
+                      "leases": _b_t2_plain(repo.list_leases(job.run_id)),
+                      "events": _b_t2_plain(repo.list_events(job.run_id)),
+                      "sql": _b_t2_snapshot(events, reads), "calls": list(calls)}
+            if after is not None:
+                result["after_poll"] = after(scoped, worker, repo, job, events, reads, observed)
+            return result
+        finally:
+            observed.wait_observer = None
+            for released in observed.release_events:
+                released.set()
+            session = worker._operational_lease_session
+            if session is not None and not session._closed:
+                operational_lease._close_worker_lease_session(session, reason="R331-fixture-finally")
+            events.close()
+            for connection in reads.values():
+                connection.close()
+
