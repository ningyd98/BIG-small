+    consistency = read_json("evidence_consistency")
+    assert consistency["consistent"] is True and consistency["run_id"] == current.run_id
+    for key in ("api_status", "job_status", "runtime_job_status", "result_status",
+                "final_attempt_status", "final_transition_status", "expected_terminal_status"):
+        assert consistency[key] == "SUCCEEDED"
+    assert all(consistency[key] is True for key in (
+        "terminal_event_present", "artifact_created_present", "lease_released"))
+    assert consistency["file_hashes"]
+    verified_files = {}
