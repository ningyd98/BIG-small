+def _r93_repin_json(root, receipt, name, value):
+    raw = module.canonical_bytes_v1(value)
+    (root / name).write_bytes(raw)
+    receipt["original_files"][name] = {
+        "sha256": hashlib.sha256(raw).hexdigest(),
+        "bytes": len(raw),
+    }
+
