  "branch_source_explanation": {
    "bridge_entry_failure": "_append catches serialization/live-size/write failures, _fault(persistence=True) disables, returnsFalse. bookkeeping_open false; sole original still executes outside catching block.",
    "startup_failure": "native._log shares profiler._fault; start _append neutral. enabled explicitly excludes persistence/invalid/saturation. Stable callbacks remain inert and absent receipt permits only no-seam continuation.",
    "midscenario_failure": "_append disables measurement, stable delegate remains no-op, original invocation count unchanged; genuine resource profile untouched.",
    "foreign_guards": "Code/current main+future hook, closure state, every present receipt, empty wait_observer validated in pure guard try before optional log. Guard catch faults then bare raises original guard.",
    "missing_receipt": "Absent receipt requires persistence_failed and not enabled; otherwise _require rejects. Allowed continuation marks UNKNOWN and cannot attach because owner isNone.",
    "exit_summary_status": "Original call in finally-only try; cleanup catches its own error, clears epoch unconditionally. _append skips after latch, _fault never throws. Status write/fsync/close catch latches invalid without retry.",
    "native_optional": "_log alone neutral with telemetry_failed; first failure invokes bounded fault callback; _snapshot bare raise still retains original rejection. All actual state/READY/register/retire defs byte-identical.",
    "critical_persistence": "_write_all unchanged throwing; _state/start/retire unchanged. Failure remains original failclosed/no-READY or process-exit-only.",
    "stderr": "_stderr_fault unchanged catches BaseException. _fault itself catches BaseException and limits16 channels; optional fault fallback attempted once, never recursive."
  },
