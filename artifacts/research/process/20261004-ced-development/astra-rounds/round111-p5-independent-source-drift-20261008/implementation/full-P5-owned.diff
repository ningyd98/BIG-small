+class CpuCounter:
+    resolution_seconds = 1e-9
+
+    def __init__(self):
+        self.now = 0
+        self.close_call_count = 0
+        self.current_identity = _identity()
+
+    def identity(self):
+        return self.current_identity
+
+    def read_ns(self):
+        return self.now
