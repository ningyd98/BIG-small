+        raise OperationalTimeError("actual one-shot transition owner required")
+    owner._check_live()
+    _TRANSITIONS[threading.get_ident()] = (
+        owner,
+        _hash(payload),
+        tuple(r["window_id"] for r in references),
+    )
+    try:
+        yield
+    finally:
+        _TRANSITIONS.pop(threading.get_ident(), None)
