+def sol_generation_parameters(
+    max_completion_tokens: int = 4096, reasoning_effort: str = "low"
+) -> dict[str, int | str]:
+    """Bound the project's Sol budget, including both reasoning and visible tokens."""
+    if type(max_completion_tokens) is not int or not 1 <= max_completion_tokens <= 32768:
+        raise ValueError("Sol completion token budget must be an integer in 1..32768")
+    if not isinstance(reasoning_effort, str) or reasoning_effort not in {
+        "low",
+        "medium",
+        "high",
+        "xhigh",
+        "max",
+    }:
+        raise ValueError("invalid Sol reasoning effort")
+    return {"reasoning_effort": reasoning_effort, "max_completion_tokens": max_completion_tokens}
+
+
+def validate_sol_route(provider: str, model: str, base_url: str, chat_path: str) -> None:
+    """Only the exact requested model is restricted to the official OpenAI route."""
+    if model == SOL_MODEL and (
+        provider != "openai_compatible"
+        or (base_url, chat_path)
+        not in {
+            ("https://api.openai.com", "/v1/chat/completions"),
+            ("https://api.openai.com/v1", "/chat/completions"),
+        }
+    ):
+        raise ValueError("Sol requires the official OpenAI Chat Completions route")
+
+
+def compatible_chat_generation(
+    model: str, generation: Mapping[str, int | float | bool | str]
+) -> dict[str, object]:
+    """Return the effective wire fields; preserve legacy compatible-provider behavior."""
+    if model == SOL_MODEL:
+        if generation and set(generation) != {"reasoning_effort", "max_completion_tokens"}:
+            raise ValueError("Sol requires only reasoning_effort and max_completion_tokens")
+        return dict(
+            sol_generation_parameters(
+                cast(int, generation.get("max_completion_tokens", 4096)),
+                cast(str, generation.get("reasoning_effort", "low")),
+            )
+        )
+    fields: dict[str, object] = {
+        "temperature": generation.get("temperature", 0),
+        "max_tokens": generation.get("num_predict", 512),
+    }
+    if "think" in generation:
+        fields["enable_thinking"] = generation["think"]
+    return fields
+
