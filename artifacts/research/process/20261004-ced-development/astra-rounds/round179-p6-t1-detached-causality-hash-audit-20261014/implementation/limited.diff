+    post = copy.deepcopy(initial)
+    body = post["payload"]
+    body["revision"] = 1
+    if family == "bootstrap":
+        claim_id = _r179_hash([
+            request["payload"]["bootstrap_id"], _r179_state_hash(initial), kind])
+        body.update(initial_capture_claimed=True,
+                    pending={"claim_id": claim_id, "effect": "CAPTURE"})
