  "findings": [
    {
      "id": "I1",
      "severity": "Important",
      "path": "src/cloud_edge_robot_arm/vision/grounded_planner.py",
      "lines": "89-94, 128-132, 255-270",
      "title": "Request binding is checked only at entry",
      "evidence": "Replacing request.observation during fixture cloud reply yields PLANNED although request/evidence checksums differ. Changing user_instruction during reply yields PLANNED with blue-cylinder instruction and red-block task target.",
      "cause": "_fresh checks the cached observation and cloud settings; mutable request/task context is reread without comparing its initial identity."
    },
    {
      "id": "I2",
      "severity": "Important",
      "path": "src/cloud_edge_robot_arm/vision/grounded_planner.py",
      "lines": "264-270",
      "title": "Duplicate JSON skills silently replace refusal",
      "evidence": "Raw {\"skills\":[],\"skills\":[valid required sequence]} produces PLANNED.",
      "cause": "Pydantic model_validate_json accepts duplicate object keys using last-wins parsing before strict field validation."
    },
    {
      "id": "I3",
      "severity": "Important",
      "path": "scripts/probe_molmo_grounded_planner.py",
      "lines": "320-349",
      "title": "Paid cloud failure is reported as passing diagnostic",
      "evidence": "CPU native fixture + real transport boundary mocked to timeout: paid_starts=1, pipeline=PLANNER_FAILED, exit=0, diagnostic_passed=true.",
      "cause": "Native success predicate always uses geometry readiness, even when --allow-paid requests cloud integration."
    },
    {
      "id": "I4",
      "severity": "Important",
      "path": "scripts/probe_molmo_grounded_planner.py",
      "lines": "222-227, 288-310, 321-330, 350-364, 380-396",
      "title": "Run evidence loses inputs, cloud bodies and failure manifests",
      "evidence": "Normal-input paid timeout run retains no cloud request body; observer discards RESPONSE bodies entirely; PlannerDraft.raw_text is omitted from saved report/raw. Failed-load fixture counts one load correctly but writes no raw-manifest.local.json. Factory role snapshot/source hashes are not emitted by grounded_planner.py:112-125.",
      "cause": "Raw capture is restricted to --capture-fresh and native provider files; the CLI observer only counts hashes and manifest creation exists only on the success path."
    },
    {
      "id": "I5",
      "severity": "Important",
      "path": "src/cloud_edge_robot_arm/vision/molmo_pointing.py",
      "lines": "317-330",
      "title": "A decoding failure erases completed generation output and count",
      "evidence": "Mock generate returns token IDs then tokenizer.decode raises: generation_calls_started=1, generation_calls_completed=0, no output-token-ids.json, failure.json exists.",
      "cause": "Token persistence and completed counter occur after decoding/parsing rather than immediately after successful generation."
    }
  ],
