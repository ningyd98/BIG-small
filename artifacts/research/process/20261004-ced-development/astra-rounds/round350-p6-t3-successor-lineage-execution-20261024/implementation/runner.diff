+def planned_input(plan, path):
+    matches = [row for row in plan["inputs"] if row["path"] == str(path)]
+    require(len(matches) == 1, "exact frozen historical input required")
+    check(matches[0])
+    return matches[0]
+
+
+def verify_origins(plan, ledger, actor):
+    require(ledger["round"] == "R350" and ledger["actor"] == actor
+            and ledger["plan_sha256"] == PLAN_SHA and ledger["budget_disposition"] == BUDGET_PIN
+            and tuple(ledger["commands"]) == KEYS, "new ledger budget/actor/generation differs")
+    for key in KEYS:
+        command, slot = plan["commands"][key], ledger["commands"][key]
+        for field in ("successor_identity", "fresh_allowance", "inherits_unused_allowance",
+                      "resets_spent_allowance", "allowance_origin", "authorized", "predecessor"):
+            require(slot[field] == command[field], "new allowance origin changed: " + key + ":" + field)
+
+
+def verify_budget(plan, root_ledger):
+    check(BUDGET_PIN)
+    budget = read_json(BUDGET)
+    require(budget["round"] == "R350" and budget["actor"] == "/root" and budget["ROOT_accepted"] is True
+            and budget["R350_plan"] == pin(D / "plan.json") and budget["same_author_binding"] == pin(BINDING),
+            "ROOT exclusive budget adoption identity differs")
+    require(budget["old_generation_launches_disabled"] is True and budget["runtime_release"] is False
+            and budget["duplicate_origin_claims_permitted"] is False
+            and budget["old_generation_fallback_permitted"] is False and budget["resets_spent_allowance"] is False,
+            "old generation eligibility or duplicate claim is forbidden")
+    require(budget["old_ledger_pins"] == plan["budget_disposition"]["original_ledger_pins"]
+            and budget["origin_mapping"] == plan["budget_disposition"]["transfers"], "exclusive origin map differs")
+    transfers = budget["origin_mapping"]
+    sources = [row["source_identity"] for row in transfers if row["source_identity"] is not None]
+    require(len(transfers) == 9 and len(sources) == len(set(sources)) == 8
+            and [row["destination"] for row in transfers] == ["R350:" + key for key in KEYS]
+            and sources == ["R346:" + key for key in KEYS[1:]]
+            and transfers[0]["kind"] == "FRESH_EXPLICIT_REPLACEMENT"
+            and transfers[0]["replaces_failed_identity"] == "R346:t3_01"
+            and budget["fresh_attempts_added"] == 1 and budget["exclusive_transferred_attempts"] == 8,
+            "one fresh/eight exclusive nonspent origins required")
+    for old_pin in budget["old_ledger_pins"]:
+        check(old_pin)
+        historical = read_json(old_pin["path"])["commands"]
+        require(tuple(historical) == KEYS and historical["t3_01"]["state"] == "SPENT"
+                and historical["t3_01"]["used"] == 1 and historical["t3_01"]["remaining"] == 0,
+                "historical failed first allowance changed")
+        require(all(historical[key]["state"] == HELD and historical[key]["used"] == 0
+                    and historical[key]["remaining"] == 1 for key in KEYS[1:]),
+                "historical transferred ledger changed or claimed")
+    verify_origins(plan, root_ledger, "/root")
+    return budget
+
