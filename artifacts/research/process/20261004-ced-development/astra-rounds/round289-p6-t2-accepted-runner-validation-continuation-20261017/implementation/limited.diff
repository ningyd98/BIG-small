+            "one exact selected prior supplement path required")
+    value = decode_json(checked(selected))
+    require(value["round"] == "R289" and value["command_id"] == name
+            and pin_identity(value["plan"]) == pin_identity(context["source_gate"]["plan"])
+            and pin_identity(value["observation"]) == pin_identity(context["source_gate"]["observation"]),
+            "prior supplement generation differs")
+    receipts = value["prior_receipts"]
+    require(type(receipts) is list and len(receipts) == len(required) <= 2
+            and [r["command_id"] for r in receipts] == required,
+            "only accepted preceding R289 receipts may be consumed")
+    expected_fields = {"command_id", "acceptance", "result", "actual_tool_return",
+                       "persistent_index", "new_retained_databases"}
+    for ordinal, row in enumerate(receipts):
+        require(set(row) == expected_fields, "exact finite prior receipt fields required")
+        acceptance = decode_json(checked(row["acceptance"]))
+        require(acceptance["round"] == "R289" and acceptance["command_id"] == row["command_id"]
+                and acceptance["status"] == "VERIFIED_COMPLETE_BEHAVIOR_CAPTURE",
+                "preceding behavior requires independent ROOT complete-capture acceptance")
+        for key in ("result", "actual_tool_return", "persistent_index"):
+            require(pin_identity(acceptance[key]) == pin_identity(row[key]),
