+def small_json(path, cap=4096):
+    """Fixed readiness/state read, stable nofollow bytes, never a live tree read."""
+    before = path.lstat()
+    require(stat.S_ISREG(before.st_mode) and before.st_size <= cap, 'bounded regular signal artifact required')
+    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    try:
+        opened = os.fstat(descriptor)
+        require(coordinates(before) == coordinates(opened), 'signal artifact changed before read')
+        raw = bytearray()
+        while len(raw) < opened.st_size:
+            chunk = os.read(descriptor, min(4096, opened.st_size - len(raw)))
+            require(bool(chunk), 'incomplete signal artifact read')
+            raw.extend(chunk)
+        require(coordinates(opened) == coordinates(os.fstat(descriptor)) == coordinates(path.lstat()),
+                'signal artifact changed during read')
+        raw = bytes(raw)
+        value = json.loads(raw)
+        require(type(value) is dict, 'signal artifact object required')
+        return value, bytes_pin(path, raw)
+    finally:
+        os.close(descriptor)
