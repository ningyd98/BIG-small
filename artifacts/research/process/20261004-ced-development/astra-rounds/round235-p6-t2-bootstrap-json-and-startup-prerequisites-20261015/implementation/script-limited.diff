+    print(json.dumps({'command': key, 'exit_code': 0, 'candidate': result['candidate'], 'result': pin(out / 'result.json')}, ensure_ascii=False))
+
+
+if __name__ == '__main__':
+    try:
+        if sys.argv != [str(D / 'implementation/prepare-evidence.py'), 'baseline']:
