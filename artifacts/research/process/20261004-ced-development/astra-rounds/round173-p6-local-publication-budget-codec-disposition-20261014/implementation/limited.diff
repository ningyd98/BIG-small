+        return self.counter("retry_cooldown_ms")
+
+    @property
+    def retry_backoff_policy(self) -> str:
+        return self.string("retry_backoff_policy")
+
+    @property
+    def effective_retry_limit(self) -> int:
+        return self.counter("effective_retry_limit")
+
+    @property
