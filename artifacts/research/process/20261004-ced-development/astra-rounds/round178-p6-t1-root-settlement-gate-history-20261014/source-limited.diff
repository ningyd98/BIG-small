 def positive(value):
     return type(value) is int and value > 0
+
+def archived_history(mapping, finding_records):
+    original = mapping["original_pin"]
+    archive = mapping["archive_pin"]
+    checked(archive)
+    raw = Path(archive["path"]).read_bytes()
+    assert len(raw) == original["bytes"] and sha(raw) == original["sha256"]
+    finding = finding_records[original["path"]]
+    assert {key: finding[key] for key in ("path", "bytes", "sha256")} == original
+    assert raw == base64.b64decode(finding["base64"], validate=True)
+    return raw
+
+def preparation_value_bytes(raw):
+    text = raw.decode()
+    marker = '"preparation_metadata":'
+    assert text.count(marker) == 1
+    start = text.index(marker) + len(marker)
+    while text[start].isspace():
+        start += 1
+    assert text[start] == "{"
+    depth, quoted, escaped = 0, False, False
+    for index in range(start, len(text)):
+        char = text[index]
+        if quoted:
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == '"':
+                quoted = False
+            continue
+        if char == '"':
+            quoted = True
+        elif char == "{":
+            depth += 1
+        elif char == "}":
+            depth -= 1
+            if depth == 0:
+                return text[start:index + 1].encode()
+    raise AssertionError("Incomplete preparation command JSON value")
 
