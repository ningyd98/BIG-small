+class _PilotCostLedger(CostLedger):
+    """Bind the transport observer to its exact cost ID before transmission."""
+
+    def __init__(self, observer: Callable[[RequestCost], None]) -> None:
+        super().__init__()
+        self.observer = observer
+
+    def record_request(self, cost: RequestCost) -> None:
+        validated = RequestCost.model_validate(cost.model_dump())
+        super().record_request(validated)
+        self.observer(validated)
+
+
+class _PilotWireCollector:
+    """Original wire plus exact planner/supervisor ledger identity; no heuristic pairing."""
+
+    def __init__(self, directory: Path, *, secret: str) -> None:
+        self.directory, self.secret = directory, secret
+        self.wire: list[dict[str, Any]] = []
+        self.pending: dict[int, dict[str, Any]] = {}
+        self.by_request_id: dict[str, dict[str, Any]] = {}
+        self.settled: dict[str, RequestCost] = {}
+        self.lock = threading.RLock()
+        self.ledger = _PilotCostLedger(self.bind_cost)
+
+    def _publish(self) -> None:
+        write_json(self.directory / "wire-index.json", self.wire)
+
+    def observe(self, phase: str, path: str, raw: bytes) -> None:
+        import hashlib
+
+        from scripts.probe_rgbd_roles import _text_contains_credential
+
+        if self.secret and _text_contains_credential(raw.decode(errors="replace"), self.secret):
+            raise ValueError("credential-bearing body withheld")
+        with self.lock:
+            thread = threading.get_ident()
+            if phase == "REQUEST":
+                if thread in self.pending:
+                    raise ValueError("unsettled wire attempt remains in this request thread")
+                entry: dict[str, Any] = {
+                    "schema_version": "ced.pilot-wire-entry.v2",
+                    "request_path": f"wire/{len(self.wire):05d}.request.raw",
+                    "request_sha256": hashlib.sha256(raw).hexdigest(),
+                    "chat_path": path,
+                    "serialized_sent_bytes": len(raw),
+                    "serialized_received_bytes": 0,
+                    "response_present": False,
+                    "response_path": None,
+                    "response_sha256": None,
+                }
+                self.wire.append(entry)
+                self.pending[thread] = entry
+                target = self.directory / entry["request_path"]
+            elif phase == "RESPONSE":
+                entry = self.pending[thread]
+                if "request_id" not in entry or entry["response_present"]:
+                    raise ValueError("duplicate response for an original request attempt")
+                entry.update(
+                    response_request_id=entry["request_id"],
+                    response_model_role=entry["model_role"],
+                    response_provider_version=entry["provider_version"],
+                    response_present=True,
+                    response_path=entry["request_path"].replace("request", "response"),
+                    response_sha256=hashlib.sha256(raw).hexdigest(),
+                    serialized_received_bytes=len(raw),
+                )
+                target = self.directory / entry["response_path"]
+            else:
+                raise ValueError("unknown original transport phase")
+            target.parent.mkdir(parents=True, exist_ok=True)
+            with target.open("xb") as stream:
+                stream.write(raw)
+            self._publish()
+
+    def bind_cost(self, row: RequestCost) -> None:
+        with self.lock:
+            thread = threading.get_ident()
+            if row.status == "IN_FLIGHT":
+                entry = self.pending[thread]
+                if row.request_id in self.by_request_id or "request_id" in entry:
+                    raise ValueError("duplicate original request/wire identity")
+                if row.serialized_sent_bytes != entry["serialized_sent_bytes"]:
+                    raise ValueError("original request observer/cost byte lengths differ")
+                entry.update(
+                    request_id=row.request_id,
+                    model_role=row.model_role,
+                    provider_version=row.provider_version,
+                )
+                self.by_request_id[row.request_id] = entry
+            else:
+                if self.settled.get(row.request_id) == row:
+                    return
+                entry = self.by_request_id[row.request_id]
+                if self.pending.get(thread) is not entry or (
+                    row.serialized_received_bytes != entry["serialized_received_bytes"]
+                ):
+                    raise ValueError("settled original request observer identity/bytes differ")
+                del self.pending[thread]
+                self.settled[row.request_id] = row
+            self._publish()
+
