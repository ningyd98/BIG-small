+def _frozen_development_exclusions() -> set[str]:
+    inventory = yaml.safe_load(CED_EXCLUSION_INVENTORY.read_text())
+    if not isinstance(inventory, dict) or set(inventory) != {
+        "schema_version",
+        "scope",
+        "group_ids",
+        "sources",
+        "content_hash",
+    }:
+        raise ValueError("frozen development exclusion inventory must be complete")
+    payload = {key: value for key, value in inventory.items() if key != "content_hash"}
+    if inventory["schema_version"] != "ced.excluded-groups.v1" or (
+        inventory["scope"] != "DEVELOPMENT_USED"
+        or inventory["content_hash"] != content_digest(payload)
+        or not isinstance(inventory["group_ids"], list)
+        or not isinstance(inventory["sources"], list)
+    ):
+        raise ValueError("frozen development exclusion schema/content binding differs")
+    groups: set[str] = set()
+    for reference in inventory["sources"]:
+        if not isinstance(reference, dict) or set(reference) != {"path", "sha256", "kind"}:
+            raise ValueError("exclusion source requires exact original hash and type")
+        path = Path(reference["path"])
+        if path.is_symlink() or file_hash(path) != reference["sha256"]:
+            raise ValueError("frozen exclusion source drift")
+        if reference["kind"] == "assignment":
+            groups.add(json.loads(path.read_text())["scene"]["group_id"])
+        elif reference["kind"] == "samples_jsonl":
+            groups.update(json.loads(line)["group_id"] for line in path.read_text().splitlines())
+        else:
+            raise ValueError("unsupported exclusion source type")
+    if not groups or sorted(groups) != inventory["group_ids"]:
+        raise ValueError("exclusion groups do not reproduce from original development sources")
+    return groups
+
