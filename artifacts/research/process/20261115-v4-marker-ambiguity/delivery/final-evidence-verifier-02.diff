 def digest(path):
     return hashlib.sha256(path.read_bytes()).hexdigest()
 
+
+def validate_final_status(jobs, events, job_id):
+    assert len(jobs) == 1
+    assert jobs[0]["job_id"] == job_id and jobs[0]["status"] == "SUCCEEDED"
+    assert events and all(event["job_id"] == job_id for event in events)
+    sequence = [event["sequence"] for event in events]
+    assert sequence == sorted(sequence) and len(set(sequence)) == len(sequence)
+    states = [event for event in events if event["next_status"]]
+    assert states and states[-1]["next_status"] == "SUCCEEDED"
+    assert states[-1]["event_type"] == "job_completed"
+    assert states[-1]["previous_status"] == "FINALIZING"
+    assert any(event["event_type"] == "job_completed" and event["next_status"] == "SUCCEEDED" for event in events)
+    return {"last_state_sequence": states[-1]["sequence"],
+            "last_event_sequence": events[-1]["sequence"],
+            "following_audit_events": [event for event in events if event["sequence"] > states[-1]["sequence"]]}
+
+
+def check_status_controls():
+    from copy import deepcopy
+    jobs = [{"job_id": "control", "status": "SUCCEEDED"}]
+    events = [{"job_id": "control", "sequence": 7, "event_type": "job_completed", "previous_status": "FINALIZING", "next_status": "SUCCEEDED"},
+              {"job_id": "control", "sequence": 8, "event_type": "artifact_created", "previous_status": "", "next_status": ""}]
+    validate_final_status(jobs, events, "control")
+    controls = [("missing_job", [], events), ("duplicate_job", jobs + jobs, events),
+                ("non_success_job", [{"job_id": "control", "status": "FAILED"}], events)]
+    failed = deepcopy(events)
+    failed.append({"job_id": "control", "sequence": 9, "event_type": "job_completed", "previous_status": "SUCCEEDED", "next_status": "FAILED"})
+    controls.append(("last_state_failed", jobs, failed))
+    missing = deepcopy(events)
+    missing[0]["event_type"] = "other"
+    controls.append(("missing_job_completed", jobs, missing))
+    foreign = deepcopy(events)
+    foreign[-1]["job_id"] = "foreign"
+    controls.append(("foreign_job_event", jobs, foreign))
+    for label, control_jobs, control_events in controls:
+        try:
+            validate_final_status(control_jobs, control_events, "control")
+        except AssertionError:
+            continue
+        raise AssertionError(f"negative status control accepted: {label}")
+    return {"positive": 1, "negative_rejected": [row[0] for row in controls]}
+
+
+status_controls = check_status_controls()
 
