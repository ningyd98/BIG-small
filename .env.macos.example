# 配置说明：macOS 本地开发默认只启用 loopback Dashboard、MuJoCo 和软件实验写入。
RUNTIME_PROFILE=simulation
SIM_BACKEND=mujoco
SIM_HEADLESS=true
MUJOCO_GL=glfw
SIM_ROBOT_PROFILE=franka_panda
SIM_SCENE_PROFILE=desktop_pick_place
SIM_ARTIFACT_DIR=artifacts/macos/simulation

DASHBOARD_AUTH_MODE=LOCAL_ONLY
DASHBOARD_EXPERIMENT_WRITES_ENABLED=true
BIGSMALL_BACKEND_PORT=8000
BIGSMALL_FRONTEND_PORT=5173

# Isaac Sim/Isaac Lab 运行时不在 macOS 上本地安装；保留远程 Linux RTX 主机验证。
# 本文件不得加入真实控制器地址、operator token 或 API 密钥。
